+def brain_sources(nv_home: Path, brain_id: str) -> list[str]:
+    """Every source folder feeding a brain. Most have exactly one (read from the
+    import overview). Brains in MULTI_SOURCE are fed from several folders, which
+    the overview can't record (last import wins) -- the full list lives there."""
+    if brain_id in MULTI_SOURCE:
+        return list(MULTI_SOURCE[brain_id])
+    src = brain_source(nv_home, brain_id)
+    return [src] if src else []
+
