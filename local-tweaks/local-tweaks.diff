     return path.name in SKIP_DIRS or path.name in extra_skip_dirs or path.name.startswith(".cache")
 
 
+def load_no_index_patterns(source: Path) -> list[str]:
+    """Read <source>/.neurovaultignore: newline-separated relative paths/globs of files
+    to BACK UP (copy to the SSD) but NOT index into the brain. Blank lines and #-comments
+    are ignored. Lets a project keep bulk data/outputs out of recall + the knowledge graph
+    while still preserving them on the SSD."""
+    f = source / NO_INDEX_FILE
+    pats: list[str] = []
+    if f.is_file():
+        for line in f.read_text(encoding="utf-8", errors="replace").splitlines():
+            s = line.strip()
+            if s and not s.startswith("#"):
+                pats.append(s.replace("\\", "/").rstrip("/"))
+    return pats
+
+
+def is_index_excluded(rel: str, no_index_patterns: list[str]) -> bool:
+    """True if this file should be copied-but-NOT-indexed: it lives under an
+    INDEX_EXCLUDE_DIRS folder, or matches a `.neurovaultignore` pattern (path prefix
+    or glob). The file is still backed up to _source_files; it just gets no sidecar,
+    so it never enters the brain's recall or graph."""
+    rel = rel.replace("\\", "/")
+    if any(part in INDEX_EXCLUDE_DIRS for part in rel.split("/")[:-1]):
+        return True
+    for pat in no_index_patterns:
+        if rel == pat or rel.startswith(pat + "/") or fnmatch.fnmatch(rel, pat):
+            return True
+    return False
+
+
 def safe_zip_member(name: str) -> bool:
     parts = Path(name.replace("\\", "/")).parts
     return bool(parts) and not any(part in {"", ".", ".."} for part in parts)
