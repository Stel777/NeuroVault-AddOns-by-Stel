+from __future__ import annotations
+
+import argparse
+import csv
+import hashlib
+import html
+import json
+import mimetypes
+import os
+import re
+import shutil
+import zipfile
+from datetime import datetime, timezone
+from pathlib import Path
+
+
+SKIP_DIRS = {
+    ".claude",
+    ".git",
+    ".hg",
+    ".svn",
+    ".next",
+    ".nuxt",
+    ".turbo",
+    ".vite",
+    ".venv",
+    "__pycache__",
+    "build",
+    "cache",
+    "coverage",
+    "cuda_outputs",
+    "dist",
+    "downloads",
+    "external-repos",
+    "node_modules",
+    "logs",
+    "live_backups",
+    "memory_backups",
+    "models",
+    "outputs",
+    "pip_cache",
+    "release",
+    "target",
+    "uploads",
+    "venv",
+    "venv_cuda",
+    "MegaGym-Website",
+}
+
+SKIP_SUFFIXES = (
+    ".neurovault.md",
+    ".neurovault.html",
+)
+
+SKIP_FILENAMES = {
+    ".env",
+    ".env.local",
+    ".env.development.local",
+    ".env.test.local",
+    ".env.production.local",
+    ".git",
+    ".skill-optimizer-ran",
+    ".cache",
+    ".metadata_cache.json",
+    "bun.lockb",
+    "libraries.json",
+    "package-lock.json",
+    "pnpm-lock.yaml",
+    "transcribepro-macos-buildkit.zip",
+    "transcribepro-windows-installer.zip",
+    "yarn.lock",
+    "youtube_cookies.txt",
+}
+
+SKIP_EXTS = {
+    ".mp4",
+    ".zip",
+}
+
+TEXT_EXTS = {
+    "",
+    ".babelrc",
+    ".css",
+    ".csv",
+    ".cc",
+    ".cmake",
+    ".cpp",
+    ".dart",
+    ".entitlements",
+    ".env",
+    ".gradle",
+    ".gitignore",
+    ".h",
+    ".htm",
+    ".html",
+    ".iml",
+    ".ini",
+    ".java",
+    ".js",
+    ".json",
+    ".jsx",
+    ".kt",
+    ".kts",
+    ".lock",
+    ".log",
+    ".m",
+    ".manifest",
+    ".md",
+    ".mjs",
+    ".pbxproj",
+    ".plist",
+    ".properties",
