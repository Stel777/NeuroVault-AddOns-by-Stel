@@ -0,0 +1,209 @@
+//! Full-project import — the in-app Sync's "import everything like the
+//! `/update-brain` skill" path.
+//!
+//! Where `source_mirror` mirrors only markdown (pure Rust, no Python), this
+//! shells out to the SAME importer the skill uses
+//! (`scripts/import_project_vault.py`): it copies every file into the vault
+//! and writes `.neurovault.md` sidecars for non-markdown (code, html,
+//! binaries). Because it's literally the same code, the output is
+//! byte-identical to `/update-brain`, so the in-app Sync and the skill never
+//! conflict on the same brain. After the importer writes the files we ingest
+//! the vault so the new sidecars become searchable.
+//!
+//! Requires Python on PATH — the same dependency the `/update-brain` skill
+//! already needs. Only invoked when the user explicitly asks for a full
+//! project import; the in-process markdown path stays Python-free.
+
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+use serde::Serialize;
+
+use super::paths::nv_home;
+use super::read_ops::registry_source_folders;
+use super::types::{MemoryError, Result};
+
+#[derive(Debug, Clone, Default, Serialize)]
+pub struct FullImportReport {
+    /// How many enabled source folders were imported.
+    pub folders_imported: u32,
+    /// Total files copied into the vault by the importer (across folders).
+    pub files_copied: u32,
+    /// Sidecars/markdown newly ingested (or re-ingested after a change).
+    pub ingested: u32,
+    /// Files whose content was unchanged (ingest short-circuited).
+    pub unchanged: u32,
+}
+
+/// First python interpreter on PATH that actually runs.
+fn find_python() -> Option<String> {
+    for cand in ["python", "python3", "py"] {
+        let ok = Command::new(cand)
+            .arg("--version")
+            .output()
+            .map(|o| o.status.success())
+            .unwrap_or(false);
+        if ok {
+            return Some(cand.to_string());
+        }
+    }
+    None
+}
+
+/// Locate `scripts/import_project_vault.py`. Honors
+/// `NEUROVAULT_IMPORTER_SCRIPT`, else searches the working directory (dev)
+/// and a few levels up from the executable.
+fn importer_script() -> Option<PathBuf> {
+    if let Ok(p) = std::env::var("NEUROVAULT_IMPORTER_SCRIPT") {
+        let pb = PathBuf::from(p);
+        if pb.is_file() {
+            return Some(pb);
+        }
+    }
+    let rel = Path::new("scripts").join("import_project_vault.py");
+    let mut roots: Vec<PathBuf> = Vec::new();
+    if let Ok(cwd) = std::env::current_dir() {
+        roots.push(cwd);
+    }
+    if let Ok(exe) = std::env::current_exe() {
+        let mut p: &Path = exe.as_path();
+        for _ in 0..6 {
+            if let Some(parent) = p.parent() {
+                roots.push(parent.to_path_buf());
+                p = parent;
+            } else {
+                break;
+            }
+        }
+    }
+    roots
+        .into_iter()
+        .map(|r| r.join(&rel))
+        .find(|c| c.is_file())
+}
+
+/// Look up a brain's current display name in `brains.json` so we can pass it
+/// through to the importer and NOT clobber it (the importer's ensure_registry
+/// would otherwise reset the name to the source folder's basename).
+fn brain_name(brain_id: &str) -> Option<String> {
+    let registry = nv_home().join("brains.json");
+    let data = std::fs::read_to_string(registry).ok()?;
+    let json: serde_json::Value = serde_json::from_str(&data).ok()?;
+    json.get("brains")?
+        .as_array()?
+        .iter()
+        .find(|b| b.get("id").and_then(|v| v.as_str()) == Some(brain_id))
+        .and_then(|b| b.get("name").and_then(|v| v.as_str()))
+        .map(|s| s.to_string())
+}
+
+/// Run the importer for one source folder into `brain_id`. Returns
+/// `files_copied` parsed from the importer's JSON summary (best-effort).
+fn run_importer(
+    python: &str,
+    script: &Path,
+    source: &str,
+    home: &Path,
+    brain_id: &str,
+    name: Option<&str>,
+) -> Result<u32> {
+    let mut cmd = Command::new(python);
+    cmd.arg(script)
+        .arg("--source")
+        .arg(source)
+        .arg("--nv-home")
+        .arg(home)
+        .arg("--brain-id")
+        .arg(brain_id);
+    if let Some(n) = name {
+        cmd.arg("--name").arg(n);
+    }
+    let output = cmd
+        .output()
+        .map_err(|e| MemoryError::Other(format!("could not run python importer: {e}")))?;
+    if !output.status.success() {
+        let err = String::from_utf8_lossy(&output.stderr);
+        return Err(MemoryError::Other(format!(
+            "project importer failed for {source}: {}",
+            err.trim()
+        )));
+    }
+    let stdout = String::from_utf8_lossy(&output.stdout);
+    let copied = serde_json::from_str::<serde_json::Value>(&stdout)
+        .ok()
+        .and_then(|v| v.get("files_copied").and_then(|n| n.as_u64()))
+        .unwrap_or(0) as u32;
+    Ok(copied)
+}
+
+/// Walk the vault for ingestable `*.md`, skipping dotfolders + `trash` — the
+/// SAME rule `/api/update` uses, so a full import and a reindex agree on what
+/// is searchable (config dotfiles stay on disk but out of the index).
+fn collect_vault_md(root: &Path, out: &mut Vec<PathBuf>) {
+    let Ok(entries) = std::fs::read_dir(root) else {
+        return;
+    };
+    for entry in entries.flatten() {
+        let path = entry.path();
+        let Some(name) = path.file_name().and_then(|n| n.to_str()) else {
+            continue;
+        };
+        if name.starts_with('.') {
+            continue;
+        }
+        if path.is_dir() {
+            if name == "trash" {
+                continue;
+            }
+            collect_vault_md(&path, out);
+        } else if path.extension().and_then(|e| e.to_str()) == Some("md") {
+            out.push(path);
+        }
+    }
+}
+
+/// Full project import for `brain_id`: run the `/update-brain` importer for
+/// every enabled source folder, then ingest the vault so the new sidecars
+/// become searchable. Requires Python + the importer script on disk.
+pub fn full_import(brain_id: &str) -> Result<FullImportReport> {
+    let folders = registry_source_folders(brain_id)?;
+    let enabled: Vec<&super::types::SourceFolder> =
+        folders.iter().filter(|f| f.enabled).collect();
+    if enabled.is_empty() {
+        return Ok(FullImportReport::default());
+    }
+
+    let python = find_python().ok_or_else(|| {
+        MemoryError::Other(
+            "Python was not found on PATH — it's required for a full project import (the same dependency the /update-brain skill uses).".into(),
+        )
+    })?;
+    let script = importer_script().ok_or_else(|| {
+        MemoryError::Other("scripts/import_project_vault.py could not be located.".into())
+    })?;
+    let home = nv_home();
+    let name = brain_name(brain_id);
+
+    let mut report = FullImportReport::default();
+    for f in &enabled {
+        report.files_copied +=
+            run_importer(&python, &script, &f.path, &home, brain_id, name.as_deref())?;
+        report.folders_imported += 1;
+    }
+
+    // Ingest the vault so the new sidecars are searchable. content_hash
+    // short-circuits unchanged files, so this only embeds what's new.
+    let vault = super::read_ops::resolve_vault_path(brain_id)?;
+    let db = super::db::open_brain(brain_id)?;
+    let mut files: Vec<PathBuf> = Vec::new();
+    collect_vault_md(&vault, &mut files);
+    for path in &files {
+        match super::ingest::ingest_file(path, Some(&vault), &db) {
+            Ok(Some(_)) => report.ingested += 1,
+            Ok(None) => report.unchanged += 1,
+            Err(e) => eprintln!("[full_import] ingest failed for {}: {}", path.display(), e),
+        }
+    }
+
+    Ok(report)
+}
