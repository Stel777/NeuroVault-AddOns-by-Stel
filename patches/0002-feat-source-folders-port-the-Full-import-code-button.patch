+  const handleFullImport = async () => {
+    setFullImporting(true);
+    setSyncResult(null);
+    setSaveError(null);
+    setPlan(null);
+    try {
+      const r = await fullImportSources(brainId);
+      setSyncResult(
+        `Full import: ${r.files_copied} files copied from ${r.folders_imported} folder${r.folders_imported === 1 ? "" : "s"}, ${r.ingested} ingested, ${r.unchanged} unchanged`,
