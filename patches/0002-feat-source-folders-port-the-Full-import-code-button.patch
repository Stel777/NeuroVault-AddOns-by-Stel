@@ -7190,3 +7190,20 @@ pub async fn brain_sources_preview(
         .map_err(ApiError::from)?;
     Ok(Json(plan))
 }
+
+/// POST /api/brains/:brain_id/sources/full_import — full parity with the
+/// `/update-brain` skill: run its importer (import_project_vault.py) for every
+/// configured source folder so ALL file types are imported (code/html/binary
+/// become `.neurovault.md` sidecars), then ingest. Requires Python on PATH.
+///
+/// `sync` only mirrors markdown; this is the "bring the whole project in" path.
+pub async fn brain_sources_full_import(
+    Path(brain_id): Path<String>,
+    _s: State<ServerState>,
+) -> Result<Json<super::project_import::FullImportReport>, ApiError> {
+    let report = tokio::task::spawn_blocking(move || super::project_import::full_import(&brain_id))
+        .await
+        .map_err(|e| ApiError(StatusCode::INTERNAL_SERVER_ERROR, e.to_string()))?
+        .map_err(ApiError::from)?;
+    Ok(Json(report))
+}
