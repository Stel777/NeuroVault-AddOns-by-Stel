diff --git a/Eject-NeuroVaultSSD.ps1 b/Eject-NeuroVaultSSD.ps1
new file mode 100644
index 0000000..81088e0
--- /dev/null
+++ b/Eject-NeuroVaultSSD.ps1
@@ -0,0 +1,84 @@
+<#
+  Eject-NeuroVaultSSD.ps1  -DriveLetter D:
+  ----------------------------------------
+  Safely removes the external SSD that hosts the NeuroVault brain, the same
+  way the Windows tray "Safely Remove Hardware" does, via
+  CM_Request_Device_Eject. Unlike "mountvol /P", this PRESERVES the drive
+  letter, so on replug the volume comes back as D: and auto-open works.
+
+  Run on demand by the "NeuroVault-Eject" scheduled task (triggered by the
+  app's Eject SSD Brain button). Sequence:
+    1. Wait for the NeuroVault app to exit (release its mmap/handles).
+    2. Stop the auto-open watcher (so its polling does not hold the volume).
+    3. CM_Request_Device_Eject, walking up the device tree to the USB node.
+    4. Re-arm the watcher for the next replug.
+    5. If it could not eject (a handle is still open, e.g. an Explorer
+       window), leave the drive mounted (data already flushed) and notify.
+
+  IMPORTANT: keep this file ASCII-only. Smart quotes / em-dashes corrupt
+  under Windows PowerShell 5.1 and cause a parse error.
+
+  Log: %LOCALAPPDATA%\NeuroVault\eject.log
+#>
+param([string]$DriveLetter = 'D:')
+
+$ErrorActionPreference = 'SilentlyContinue'
+$Task   = 'NeuroVault Auto-Open on SSD'
+$dl     = $DriveLetter.TrimEnd('\').TrimEnd(':')          # 'D'
+$marker = "${dl}:\NEURO-VAULT-STORAGE\.neurovault\brains.json"
+$log    = Join-Path $env:LOCALAPPDATA 'NeuroVault\eject.log'
+New-Item -ItemType Directory -Force -Path (Split-Path $log) | Out-Null
+function L($m){ "$([DateTime]::Now.ToString('yyyy-MM-dd HH:mm:ss'))  $m" | Out-File $log -Append -Encoding utf8 }
+
+L "eject requested for ${dl}:"
+
+# 1. Wait for the app to fully exit (releases brain.db + its 256MB mmap).
+for ($i = 0; $i -lt 40; $i++) { if (-not (Get-Process neurovault -ErrorAction SilentlyContinue)) { break }; Start-Sleep -Milliseconds 500 }
+Start-Sleep -Milliseconds 800
+L "app exited; stopping watcher"
+
+# 2. Stop the auto-open watcher so its 4s D: poll cannot veto the eject.
+Stop-ScheduledTask -TaskName $Task -ErrorAction SilentlyContinue
+Get-CimInstance Win32_Process -Filter "Name='powershell.exe'" |
+  Where-Object { $_.CommandLine -like '*Watch-NeuroVault-SSD*' } |
+  ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }
+Start-Sleep -Milliseconds 600
+
+# 3. Device-level safe removal.
+Add-Type -TypeDefinition @'
+using System; using System.Text; using System.Runtime.InteropServices;
+public static class NvPnp {
+  [DllImport("CfgMgr32.dll", CharSet=CharSet.Unicode)] public static extern int CM_Locate_DevNode(out uint d, string id, int f);
+  [DllImport("CfgMgr32.dll")] public static extern int CM_Get_Parent(out uint p, uint d, int f);
+  [DllImport("CfgMgr32.dll", CharSet=CharSet.Unicode)] public static extern int CM_Request_Device_Eject(uint d, out int v, StringBuilder n, int len, int f);
+}
+'@ -ErrorAction SilentlyContinue
+
+$ejected = $false
+$disk = Get-Partition -DriveLetter $dl -ErrorAction SilentlyContinue | Get-Disk -ErrorAction SilentlyContinue
+if ($disk) {
+  $pnp = (Get-CimInstance Win32_DiskDrive | Where-Object { $_.Index -eq $disk.Number }).PNPDeviceID
+  $node = 0
+  [NvPnp]::CM_Locate_DevNode([ref]$node, $pnp, 0) | Out-Null
+  for ($lvl = 0; $lvl -lt 4; $lvl++) {
+    $veto = 0; $vn = New-Object System.Text.StringBuilder 512
+    $r = [NvPnp]::CM_Request_Device_Eject($node, [ref]$veto, $vn, 512, 0)
+    L "level $lvl eject=$r veto=$veto"
+    Start-Sleep -Milliseconds 1500
+    if (-not (Test-Path $marker)) { $ejected = $true; L "EJECTED at level $lvl"; break }
+    $p = 0; if ([NvPnp]::CM_Get_Parent([ref]$p, $node, 0) -ne 0) { break }; $node = $p
+  }
+} else { L "no disk found for ${dl}:" }
+
+# 4. Re-arm the watcher for the next replug.
+Start-ScheduledTask -TaskName $Task -ErrorAction SilentlyContinue
+
+# 5. Feedback.
+if ($ejected) {
+  L "done: safely removed ${dl}:"
+} else {
+  L "could NOT eject ${dl}: (a handle is still open) - drive left mounted, data already flushed"
+  Add-Type -AssemblyName System.Windows.Forms -ErrorAction SilentlyContinue
+  $msg = "NeuroVault flushed and saved everything, but could not auto-eject ${dl}: because another program (often a File Explorer window open to the drive) still has it open." + [Environment]::NewLine + [Environment]::NewLine + "Close that, then use Windows 'Safely Remove Hardware', or just close it and unplug. Your data is safe."
+  [System.Windows.Forms.MessageBox]::Show($msg, "NeuroVault: SSD still in use", 'OK', 'Warning') | Out-Null
+}
diff --git a/Register-NeuroVault-AutoOpen.ps1 b/Register-NeuroVault-AutoOpen.ps1
new file mode 100644
index 0000000..dfc995e
--- /dev/null
+++ b/Register-NeuroVault-AutoOpen.ps1
@@ -0,0 +1,47 @@
+<#
+  Register-NeuroVault-AutoOpen.ps1
+  --------------------------------
+  Registers (or removes) a hidden Scheduled Task that runs
+  Watch-NeuroVault-SSD.ps1 at logon, so NeuroVault auto-opens whenever
+  the NeuroVault SSD is connected.
+
+  Usage:
+    powershell -ExecutionPolicy Bypass -File Register-NeuroVault-AutoOpen.ps1
+    powershell -ExecutionPolicy Bypass -File Register-NeuroVault-AutoOpen.ps1 -Remove
+
+  No admin rights needed — it registers a per-user task.
+#>
+param([switch]$Remove)
+
+$ErrorActionPreference = 'Stop'
+$TaskName = 'NeuroVault Auto-Open on SSD'
+$Watcher  = Join-Path $PSScriptRoot 'Watch-NeuroVault-SSD.ps1'
+
+if ($Remove) {
+    Unregister-ScheduledTask -TaskName $TaskName -Confirm:$false -ErrorAction SilentlyContinue
+    "Removed scheduled task '$TaskName'."
+    return
+}
+
+if (-not (Test-Path -LiteralPath $Watcher)) {
+    throw "Watcher script not found next to this file: $Watcher"
+}
+
+$action = New-ScheduledTaskAction -Execute 'powershell.exe' `
+    -Argument "-NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File `"$Watcher`""
+
+$trigger = New-ScheduledTaskTrigger -AtLogOn -User $env:USERNAME
+
+$settings = New-ScheduledTaskSettingsSet `
+    -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries `
+    -StartWhenAvailable -MultipleInstances IgnoreNew `
+    -ExecutionTimeLimit ([TimeSpan]::Zero) `
+    -RestartCount 3 -RestartInterval (New-TimeSpan -Minutes 1)
+
+$principal = New-ScheduledTaskPrincipal -UserId "$env:USERDOMAIN\$env:USERNAME" `
+    -LogonType Interactive -RunLevel Limited
+
+Register-ScheduledTask -TaskName $TaskName -Action $action -Trigger $trigger `
+    -Settings $settings -Principal $principal -Force | Out-Null
+
+"Registered scheduled task '$TaskName' (runs hidden at logon)."
diff --git a/Register-NeuroVault-Eject.ps1 b/Register-NeuroVault-Eject.ps1
new file mode 100644
index 0000000..89b02f3
--- /dev/null
+++ b/Register-NeuroVault-Eject.ps1
@@ -0,0 +1,48 @@
+<#
+  Register-NeuroVault-Eject.ps1
+  -----------------------------
+  Registers (or removes) the on-demand "NeuroVault-Eject" scheduled task.
+  The Eject SSD Brain button triggers this task (schtasks /Run). Running the
+  eject as a task — rather than a child process the app spawns — means it:
+    * survives the app closing (a task is independent of the app's process
+      tree, so it isn't killed when NeuroVault exits), and
+    * runs elevated (RunLevel Highest), so the device-eject of the
+      Fixed-type USB SSD is never blocked by insufficient rights.
+
+  The task runs Eject-NeuroVaultSSD.ps1, which waits for the app to exit,
+  then safely removes the drive (CM_Request_Device_Eject, preserving the
+  drive letter) and re-arms the auto-open watcher.
+
+  Usage:
+    powershell -ExecutionPolicy Bypass -File Register-NeuroVault-Eject.ps1
+    powershell -ExecutionPolicy Bypass -File Register-NeuroVault-Eject.ps1 -Remove
+#>
+param([switch]$Remove)
+
+$ErrorActionPreference = 'Stop'
+$TaskName = 'NeuroVault-Eject'
+$Script   = Join-Path $PSScriptRoot 'Eject-NeuroVaultSSD.ps1'
+
+if ($Remove) {
+    Unregister-ScheduledTask -TaskName $TaskName -Confirm:$false -ErrorAction SilentlyContinue
+    "Removed scheduled task '$TaskName'."
+    return
+}
+
+if (-not (Test-Path -LiteralPath $Script)) { throw "Eject script not found: $Script" }
+
+$action = New-ScheduledTaskAction -Execute 'powershell.exe' `
+    -Argument "-NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File `"$Script`" -DriveLetter D:"
+
+$settings = New-ScheduledTaskSettingsSet `
+    -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries `
+    -MultipleInstances IgnoreNew `
+    -ExecutionTimeLimit (New-TimeSpan -Minutes 5)
+
+$principal = New-ScheduledTaskPrincipal -UserId "$env:USERDOMAIN\$env:USERNAME" `
+    -LogonType Interactive -RunLevel Highest
+
+# No trigger — this task is launched on demand by the app (schtasks /Run).
+Register-ScheduledTask -TaskName $TaskName -Action $action -Settings $settings -Principal $principal -Force | Out-Null
+
+"Registered on-demand task '$TaskName' (runs Eject-NeuroVaultSSD.ps1, elevated)."
diff --git a/Show-NeuroVault-Splash.ps1 b/Show-NeuroVault-Splash.ps1
new file mode 100644
index 0000000..8fa84e8
--- /dev/null
+++ b/Show-NeuroVault-Splash.ps1
@@ -0,0 +1,201 @@
+<#
+  Show-NeuroVault-Splash.ps1
+  --------------------------
+  Slick, minimal loading indicator shown the instant the NeuroVault SSD
+  is detected, so you get feedback while `tauri dev` boots + compiles.
+
+  Look: a fully transparent, borderless window floating over the desktop
+  with the NeuroVault mark in the center and an animated ring around it.
+
+  It is intentionally independent of the Tauri app: it appears BEFORE
+  the app window exists (during the Vite + cargo build), then closes
+  itself the moment the real NeuroVault window comes up.
+
+  -Style:
+    spin  - a short bright arc rotates endlessly around the ring (default).
+    fill  - the ring fills clockwise like a progress circle, then gently
+            pulses if the app still isn't up.
+    both  - fills once, then switches to the rotating arc so it never
+            looks stuck.
+
+  Self-closing logic:
+    - polls for a `neurovault` process whose main window is visible,
+    - or gives up after a safety timeout (so it never hangs forever).
+
+  Launched (hidden) by Watch-NeuroVault-SSD.ps1 on the SSD-connect
+  transition.
+
+  Preview:
+    powershell -ExecutionPolicy Bypass -File Show-NeuroVault-Splash.ps1 -Preview -Style fill
+    (runs for ~8s even if NeuroVault is already open, shows a caption,
+     so you can compare styles)
+#>
+param(
+    [switch]$Preview,
+    [ValidateSet('spin','fill','both')]
+    [string]$Style = 'fill',
+    [int]$PreviewOffsetX = 0
+)
+
+$ErrorActionPreference = 'SilentlyContinue'
+
+# ---- Config ---------------------------------------------------------------
+$TimeoutSeconds = 120   # hard cap: never keep the splash up longer than this
+$PollMs         = 750   # how often to check whether the app window is up
+$LogoRelative   = 'assets\brand\neurovault-mark-1024.png'
+$FillSeconds    = if ($Preview) { 4 } else { 25 }   # est. fill duration
+# ---------------------------------------------------------------------------
+
+Add-Type -AssemblyName PresentationFramework
+Add-Type -AssemblyName PresentationCore
+Add-Type -AssemblyName WindowsBase
+
+function NeuroVault-WindowUp {
+    $p = Get-Process -Name 'neurovault' -ErrorAction SilentlyContinue |
+         Where-Object { $_.MainWindowHandle -ne 0 } | Select-Object -First 1
+    return [bool]$p
+}
+
+# If the app is already up, there's nothing to wait for (unless previewing).
+if (-not $Preview -and (NeuroVault-WindowUp)) { return }
+
+# ---- Build the window from XAML ------------------------------------------
+[xml]$xaml = @"
+<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
+        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
+        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
+        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
+        Width="184" Height="208">
+  <Grid>
+    <!-- faint full ring (the track) -->
+    <Ellipse Width="150" Height="150" Margin="0,0,0,24"
+             HorizontalAlignment="Center" VerticalAlignment="Center"
+             Stroke="#2F7BFF" StrokeThickness="6" Opacity="0.16"/>
+
+    <!-- spinning arc (~95 degrees) -->
+    <Path x:Name="spinArc" Stroke="#2F7BFF" StrokeThickness="6"
+          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
+          HorizontalAlignment="Center" VerticalAlignment="Center"
+          Margin="0,0,0,24" Visibility="Collapsed"
+          Data="M 75,0 A 75,75 0 0 1 150,75"
+          RenderTransformOrigin="0.5,0.5">
+      <Path.RenderTransform>
+        <RotateTransform x:Name="spin" Angle="0"/>
+      </Path.RenderTransform>
+    </Path>
+
+    <!-- filling ring (progress style) -->
+    <Ellipse x:Name="fillRing" Width="150" Height="150" Margin="0,0,0,24"
+             HorizontalAlignment="Center" VerticalAlignment="Center"
+             Stroke="#2F7BFF" StrokeThickness="6" StrokeDashCap="Round"
+             Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
+      <Ellipse.RenderTransform>
+        <RotateTransform Angle="-90"/>
+      </Ellipse.RenderTransform>
+    </Ellipse>
+
+    <!-- NeuroVault mark in the center -->
+    <Image x:Name="logo" Width="78" Height="78" Margin="0,0,0,24"
+           HorizontalAlignment="Center" VerticalAlignment="Center"/>
+
+    <!-- preview-only caption -->
+    <TextBlock x:Name="caption" Text="" Foreground="#8C96AF"
+               FontFamily="Segoe UI" FontSize="12"
+               HorizontalAlignment="Center" VerticalAlignment="Bottom"
+               Margin="0,0,0,6"/>
+  </Grid>
+</Window>
+"@
+
+$reader        = New-Object System.Xml.XmlNodeReader $xaml
+$script:window = [Windows.Markup.XamlReader]::Load($reader)
+
+$spinArc  = $script:window.FindName('spinArc')
+$spin     = $script:window.FindName('spin')
+$fillRing = $script:window.FindName('fillRing')
+
+# logo source
+$logoPath = Join-Path $PSScriptRoot $LogoRelative
+if (Test-Path -LiteralPath $logoPath) {
+    $bmp = New-Object System.Windows.Media.Imaging.BitmapImage
+    $bmp.BeginInit()
+    $bmp.CacheOption = 'OnLoad'
+    $bmp.UriSource   = New-Object System.Uri($logoPath)
+    $bmp.EndInit()
+    ($script:window.FindName('logo')).Source = $bmp
+}
+
+if ($Preview) {
+    ($script:window.FindName('caption')).Text = $Style
+    if ($PreviewOffsetX -ne 0) {
+        $sw = [System.Windows.SystemParameters]::PrimaryScreenWidth
+        $sh = [System.Windows.SystemParameters]::PrimaryScreenHeight
+        $script:window.WindowStartupLocation = 'Manual'
+        $script:window.Left = ($sw / 2) - ($script:window.Width / 2) + $PreviewOffsetX
+        $script:window.Top  = ($sh / 2) - ($script:window.Height / 2)
+    }
+}
+
+# ---- Animations -----------------------------------------------------------
+function Start-Spin {
+    $spinArc.Visibility = 'Visible'
+    $a = New-Object System.Windows.Media.Animation.DoubleAnimation
+    $a.From = 0; $a.To = 360
+    $a.Duration       = New-Object System.Windows.Duration ([TimeSpan]::FromSeconds(1.15))
+    $a.RepeatBehavior = [System.Windows.Media.Animation.RepeatBehavior]::Forever
+    $spin.BeginAnimation([System.Windows.Media.RotateTransform]::AngleProperty, $a)
+}
+
+function Start-Pulse {
+    $p = New-Object System.Windows.Media.Animation.DoubleAnimation
+    $p.From = 1.0; $p.To = 0.4
+    $p.Duration       = New-Object System.Windows.Duration ([TimeSpan]::FromSeconds(0.9))
+    $p.AutoReverse    = $true
+    $p.RepeatBehavior = [System.Windows.Media.Animation.RepeatBehavior]::Forever
+    $fillRing.BeginAnimation([System.Windows.UIElement]::OpacityProperty, $p)
+}
+
+function Start-Fill([bool]$loop, [scriptblock]$onDone) {
+    $L = [Math]::PI * 150.0 / 6.0    # circumference in stroke-thickness units
+    $fillRing.StrokeDashArray  = New-Object System.Windows.Media.DoubleCollection (,[double[]]@($L, $L))
+    $fillRing.StrokeDashOffset = $L
+    $fillRing.Visibility       = 'Visible'
+    $a = New-Object System.Windows.Media.Animation.DoubleAnimation
+    $a.From = $L; $a.To = 0
+    $a.Duration = New-Object System.Windows.Duration ([TimeSpan]::FromSeconds($FillSeconds))
+    if ($loop) {
+        $a.RepeatBehavior = [System.Windows.Media.Animation.RepeatBehavior]::Forever
+    } elseif ($onDone) {
+        $a.Add_Completed($onDone)
+    }
+    $fillRing.BeginAnimation([System.Windows.Shapes.Shape]::StrokeDashOffsetProperty, $a)
+}
+
+switch ($Style) {
+    'spin' { Start-Spin }
+    'fill' {
+        if ($Preview) { Start-Fill $true $null }
+        else          { Start-Fill $false { Start-Pulse } }
+    }
+    'both' {
+        Start-Fill $false {
+            $fillRing.Visibility = 'Collapsed'
+            Start-Spin
+        }
+    }
+}
+
+# ---- Self-close logic -----------------------------------------------------
+$script:deadline = if ($Preview) { (Get-Date).AddSeconds(8) } else { (Get-Date).AddSeconds($TimeoutSeconds) }
+$script:timer = New-Object System.Windows.Threading.DispatcherTimer
+$script:timer.Interval = [TimeSpan]::FromMilliseconds($PollMs)
+$script:timer.Add_Tick({
+    $up = if ($Preview) { $false } else { NeuroVault-WindowUp }
+    if ($up -or ((Get-Date) -gt $script:deadline)) {
+        $script:timer.Stop()
+        $script:window.Close()
+    }
+})
+$script:timer.Start()
+
+$script:window.ShowDialog() | Out-Null
diff --git a/Watch-NeuroVault-SSD.ps1 b/Watch-NeuroVault-SSD.ps1
new file mode 100644
index 0000000..0d73cd8
--- /dev/null
+++ b/Watch-NeuroVault-SSD.ps1
@@ -0,0 +1,78 @@
+<#
+  Watch-NeuroVault-SSD.ps1
+  -------------------------
+  Auto-launches NeuroVault when the NeuroVault SSD is connected.
+
+  How it identifies "the" SSD: not by drive letter (which can change),
+  but by the presence of the marker file
+      <drive>:\NEURO-VAULT-STORAGE\.neurovault\brains.json
+  So whatever letter the drive mounts as, this finds it.
+
+  Behaviour:
+    - Launches on the CONNECT transition (absent -> present), so closing
+      NeuroVault while the SSD stays plugged in does NOT reopen it.
+    - Skips launching if NeuroVault is already running.
+    - If the SSD is already plugged in when this watcher starts (e.g. at
+      logon), that counts as a connect and it launches once.
+
+  Runs continuously in the background. Registered to start at logon by
+  Register-NeuroVault-AutoOpen.ps1 (a hidden Scheduled Task).
+#>
+
+$ErrorActionPreference = 'SilentlyContinue'
+
+# ---- Config ---------------------------------------------------------------
+$MarkerRelative = 'NEURO-VAULT-STORAGE\.neurovault\brains.json'
+$Launcher       = 'C:\Users\steli\Documents\Claude_Projects\NeuroVault_byDath\Start-NeuroVault-SSD.cmd'
+$PollSeconds    = 4
+$LogFile        = Join-Path $env:LOCALAPPDATA 'NeuroVault\auto-open.log'
+# ---------------------------------------------------------------------------
+
+New-Item -ItemType Directory -Force -Path (Split-Path $LogFile) | Out-Null
+
+function Write-Log([string]$msg) {
+    "$([DateTime]::Now.ToString('yyyy-MM-dd HH:mm:ss'))  $msg" | Out-File -FilePath $LogFile -Append -Encoding utf8
+}
+
+function Find-SsdDrive {
+    foreach ($d in (Get-PSDrive -PSProvider FileSystem -ErrorAction SilentlyContinue)) {
+        $candidate = Join-Path ($d.Root) $MarkerRelative
+        if (Test-Path -LiteralPath $candidate) { return $d.Root.TrimEnd('\') }
+    }
+    return $null
+}
+
+function NeuroVault-Running {
+    [bool](Get-Process -Name 'neurovault' -ErrorAction SilentlyContinue)
+}
+
+function Show-Splash {
+    $splash = Join-Path $PSScriptRoot 'Show-NeuroVault-Splash.ps1'
+    if (-not (Test-Path -LiteralPath $splash)) { return }
+    Start-Process -FilePath 'powershell.exe' `
+        -ArgumentList '-NoProfile', '-WindowStyle', 'Hidden', '-ExecutionPolicy', 'Bypass', '-File', "`"$splash`"" `
+        -WindowStyle Hidden
+}
+
+function Launch-NeuroVault([string]$drive) {
+    if (NeuroVault-Running) { Write-Log "SSD at $drive but NeuroVault already running - skip"; return }
+    if (-not (Test-Path -LiteralPath $Launcher)) { Write-Log "Launcher not found: $Launcher"; return }
+    Write-Log "SSD detected at $drive - showing splash + launching NeuroVault"
+    Show-Splash   # instant feedback while tauri dev boots/compiles; self-closes when the app window is up
+    Start-Process -FilePath 'cmd.exe' -ArgumentList '/c', "`"$Launcher`"" -WindowStyle Hidden
+}
+
+Write-Log "watcher started (poll ${PollSeconds}s, marker '$MarkerRelative')"
+
+$prevPresent = $false
+while ($true) {
+    $drive   = Find-SsdDrive
+    $present = [bool]$drive
+    if ($present -and -not $prevPresent) {
+        # Fresh connect (or SSD already present at watcher start).
+        Start-Sleep -Seconds 2   # let the volume + drive letter settle
+        if (Find-SsdDrive) { Launch-NeuroVault $drive }
+    }
+    $prevPresent = $present
+    Start-Sleep -Seconds $PollSeconds
+}
-- 
2.53.0.windows.2

