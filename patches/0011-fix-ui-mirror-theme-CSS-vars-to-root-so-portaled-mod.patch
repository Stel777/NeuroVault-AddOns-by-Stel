From 1970c8d7e39aec5d2635a203e8c9d91f0044c4aa Mon Sep 17 00:00:00 2001
From: Stel777 <274792865+Stel777@users.noreply.github.com>
Date: Wed, 17 Jun 2026 02:20:26 +0300
Subject: [PATCH 11/11] fix(ui): mirror theme CSS vars to :root so portaled
 modals inherit them

The theme's --nv-* custom properties were set only on the app wrapper div,
so UI portaled into document.body (the BrainSourcesPanel modal) inherited
none of them and rendered transparent. Mirror them onto :root as well.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 src/App.tsx | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/src/App.tsx b/src/App.tsx
index c1e0267..caf8107 100644
--- a/src/App.tsx
+++ b/src/App.tsx
@@ -576,6 +576,15 @@ export default function App() {
     "--nv-negative": theme.negative,
   } as React.CSSProperties & Record<string, string>;
 
+  // Mirror the theme vars onto :root too, so UI portaled into document.body
+  // (e.g. the BrainSourcesPanel modal) inherits them. Without this, those
+  // portals sit outside the themed wrapper <div> below and every var(--nv-*)
+  // resolves to nothing → transparent backgrounds.
+  useEffect(() => {
+    const root = document.documentElement;
+    for (const [k, v] of Object.entries(themeVars)) root.style.setProperty(k, String(v));
+  }, [themeVars]);
+
   return (
     <div
       className={`flex flex-col h-screen overflow-hidden font-[Geist,sans-serif]${reduceMotion ? " nv-reduce-motion" : ""}`}
-- 
