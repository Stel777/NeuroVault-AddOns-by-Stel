+    let folders = match super::read_ops::registry_source_folders(brain_id) {
+        Ok(f) => f,
+        Err(e) => {
+            eprintln!(
+                "[watcher] could not read source_folders for {}: {}",
+                brain_id, e
+            );
+            return (Vec::new(), None);
+        }
+    };
