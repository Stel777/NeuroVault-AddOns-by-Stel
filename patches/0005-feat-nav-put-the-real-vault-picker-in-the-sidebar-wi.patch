@@ -28,10 +28,25 @@ export function BrainSelector({
   triggerLabel,
   placement = "up",
   mode = "switch",
+  tone = "app",
+  onSwitch,
+  disabled = false,
 }: {
   triggerLabel?: string;
   placement?: "up" | "down";
   mode?: "switch" | "manage";
+  /** Which palette the TRIGGER draws from. The sidebar is dark in every theme
+   *  and has its own `--nv-nav-*` vars, so app-theme text would be unreadable
