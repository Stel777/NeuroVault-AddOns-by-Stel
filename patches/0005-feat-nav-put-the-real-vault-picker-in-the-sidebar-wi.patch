+   *  activates the brain directly. */
+  onSwitch?: (brainId: string) => void | Promise<void>;
+  /** Lock the trigger while the host is mid-transition, so a second vault
+   *  cannot be selected before the first activation finishes. */
+  disabled?: boolean;
 } = {}) {
   const { brains, activeBrainName, loading, switchBrain, createBrain, updateBrain, deleteBrain, loadBrains } =
     useBrainStore();
@@ -143,6 +158,14 @@ export function BrainSelector({
   const handleSwitch = async (brainId: string) => {
     setOpen(false);
     setSortMenuOpen(false);
+    // The sidebar has to do more than flip the active brain: it navigates off
+    // vault-scoped views first so they cannot keep operating against the old
+    // vault mid-switch, and it handles a note that failed to save. When a host
+    // supplies that flow, defer to it rather than switching behind its back.
+    if (onSwitch) {
+      await onSwitch(brainId);
+      return;
+    }
     await switchBrain(brainId);
   };
 
