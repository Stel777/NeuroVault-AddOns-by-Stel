From 77e66f7182c30142fc8ded7be4be54f29257aa43 Mon Sep 17 00:00:00 2001
From: Stel777 <274792865+Stel777@users.noreply.github.com>
Date: Tue, 16 Jun 2026 19:33:27 +0300
Subject: [PATCH 07/11] fix(source-folders): ignore node_modules/build dirs;
 tolerate watcher race
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Two bugs surfaced pointing a real project folder at a brain:

1. The mirror walked into node_modules/.git/dist/build/cache dirs and tried
   to ingest thousands of vendored README/CHANGELOG .md files, flooding the
   brain. Add an ignore-list (is_ignored_dir) to collect_md_files so only
   genuine project markdown is mirrored.

2. The mirror's own ingest raced the vault watcher (which also ingests the
   copied file for the active brain), surfacing as
   `UNIQUE constraint failed: engrams.filename`. Keep the direct ingest
   (so inactive brains, which have no running watcher, still get indexed)
   but swallow the UNIQUE-constraint error — it just means the watcher won
   the insert and the file is already indexed.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 src-tauri/src/memory/source_mirror.rs | 44 ++++++++++++++++++++++++---
 1 file changed, 40 insertions(+), 4 deletions(-)

diff --git a/src-tauri/src/memory/source_mirror.rs b/src-tauri/src/memory/source_mirror.rs
index 00d59fc..6196139 100644
--- a/src-tauri/src/memory/source_mirror.rs
+++ b/src-tauri/src/memory/source_mirror.rs
@@ -191,8 +191,26 @@ fn source_slug(source_root_abs: &str) -> String {
     format!("{}-{}", base_slug, &hex.as_str()[..8])
 }
 
+/// Directory names that are never worth mirroring: dependency trees, VCS
+/// internals, build output, and caches. Skipping them is what stops a
+/// source folder from flooding a brain with thousands of vendored
+/// `README.md` / `CHANGELOG.md` files — the `node_modules` problem. Match
+/// is case-insensitive so `Node_Modules` etc. are caught too.
+fn is_ignored_dir(name: &str) -> bool {
+    const IGNORED: &[&str] = &[
+        "node_modules", ".git", ".svn", ".hg", "dist", "build", "target",
+        ".next", ".nuxt", "out", ".output", ".cache", ".turbo", ".parcel-cache",
+        "coverage", "vendor", "__pycache__", ".venv", "venv", "env",
+        "bower_components", ".idea", ".vscode", ".gradle", "pods", ".pytest_cache",
+        ".mypy_cache", ".tox", "obj", ".terraform", ".serverless", ".expo",
+    ];
+    let lower = name.to_ascii_lowercase();
+    IGNORED.iter().any(|d| *d == lower)
+}
+
 /// Recursively collect every `*.md` file under `root`. Skips symlinks
-/// (a misconfigured source can't escape via a link) and silently
+/// (a misconfigured source can't escape via a link), skips dependency /
+/// build / cache directories (see `is_ignored_dir`), and silently
 /// tolerates unreadable subdirectories — best-effort, matching the
 /// `count_markdown` / `walk_and_delete_md` helpers elsewhere in the
 /// crate. We use std recursion rather than pulling in `walkdir`
@@ -208,6 +226,11 @@ fn collect_md_files(root: &Path, out: &mut Vec<PathBuf>) {
             continue;
         }
         if ft.is_dir() {
+            // Skip dependency/build/cache dirs so a source folder can't
+            // flood the brain with vendored markdown.
+            if entry.file_name().to_str().map(is_ignored_dir).unwrap_or(false) {
+                continue;
+            }
             collect_md_files(&path, out);
         } else if path.extension().and_then(|e| e.to_str()).map(|e| e.eq_ignore_ascii_case("md")).unwrap_or(false) {
             // TODO: only *.md files are mirrored today. Other file types
@@ -315,14 +338,27 @@ fn mirror_one_file(
         }
     }
 
-    // Copy bytes into the vault (create parent dirs), then ingest the
-    // vault copy so folder structure round-trips through the DB.
+    // Copy bytes into the vault (create parent dirs), then ingest so the
+    // engram exists immediately — this works whether or not the brain is
+    // the active one (an inactive brain has no running vault watcher, so we
+    // can't rely on the watcher alone).
+    //
+    // Race tolerance: for the ACTIVE brain the vault watcher ALSO sees this
+    // write and may ingest the same file concurrently, which can surface as
+    // `UNIQUE constraint failed: engrams.filename`. That just means the
+    // other side won the insert and the file is already indexed — not a
+    // real failure — so we swallow exactly that error and let anything else
+    // propagate.
     let target = ctx.vault.join(&vault_rel);
     if let Some(parent) = target.parent() {
         std::fs::create_dir_all(parent)?;
     }
     std::fs::write(&target, &bytes)?;
-    let _ = ingest::ingest_file(&target, Some(&ctx.vault), &ctx.db)?;
+    match ingest::ingest_file(&target, Some(&ctx.vault), &ctx.db) {
+        Ok(_) => {}
+        Err(e) if e.to_string().contains("UNIQUE constraint") => {}
+        Err(e) => return Err(e),
+    }
 
     manifest.insert(
         vault_rel.clone(),
