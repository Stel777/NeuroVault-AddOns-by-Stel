+/// data root through the same function, so plugging the SSD in points every
+/// entry point at the same brains.
+fn plugged_in_ssd_home() -> Option<PathBuf> {
+    #[cfg(windows)]
+    {
+        const MARKER: &str = r"NEURO-VAULT-STORAGE\.neurovault";
+        let preferred = PathBuf::from(format!(r"D:\{MARKER}"));
+        if preferred.join("brains.json").is_file() {
+            return Some(preferred);
+        }
+        for drive in b'A'..=b'Z' {
+            let candidate = PathBuf::from(format!(r"{}:\{MARKER}", drive as char));
+            if candidate.join("brains.json").is_file() {
+                return Some(candidate);
+            }
+        }
+    }
+    None
+}
