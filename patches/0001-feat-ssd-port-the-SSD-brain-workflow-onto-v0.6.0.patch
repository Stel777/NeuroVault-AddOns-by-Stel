+/// Safely flush + eject the external SSD that hosts the brain vault.
+///
+/// The SSD is an organized clone of source material that also lives on C:, so
+/// no off-drive copy is made — the eject just makes the on-disk database
+/// consistent, then releases the drive.
+///
+/// Steps, in order:
+///   1. Trigger the pre-registered "NeuroVault-Eject" scheduled task. A task
+///      runs outside this app's process tree, so it SURVIVES the app closing —
+///      a spawned child gets killed the moment the app exits, which is why an
+///      inline helper never finished. The task also runs elevated, so ejecting
+///      a Fixed-type USB SSD isn't blocked. Its script waits for this process
+///      to exit, then calls CM_Request_Device_Eject (which PRESERVES the drive
+///      letter for replug) and re-arms the auto-open watcher. Triggered FIRST
+///      so a missing-task failure aborts with no side effects.
+///   2. Stop the vault watchers so nothing writes during the checkpoint.
+///   3. WAL-checkpoint every open brain so `brain.db` is fully written.
+///   4. Drop all cached DB handles (unmaps the 256 MiB mmap, closes the files).
+///
+/// Returns a human-readable summary the UI can toast. Errors leave the drive
+/// un-ejected; the data is still flushed and safe on the SSD.
+#[tauri::command]
+fn nv_eject_ssd_brain() -> std::result::Result<String, String> {
+    let home = memory::paths::nv_home();
+    let home_str = home.to_string_lossy().to_string();
+    // Drive letter like "D:" from the brain-home path prefix.
+    let drive = if home_str.len() >= 2 && home_str.as_bytes()[1] == b':' {
+        home_str[..2].to_uppercase()
+    } else {
+        return Err("Could not determine the SSD drive letter from the brain home path.".to_string());
+    };
+    if drive == "C:" {
+        return Err(
+            "The active brain is on the system drive (C:), not a removable SSD — nothing to eject."
+                .to_string(),
+        );
+    }
+
+    #[cfg(windows)]
+    {
+        use std::os::windows::process::CommandExt;
+        const CREATE_NO_WINDOW: u32 = 0x0800_0000;
+        let status = std::process::Command::new("schtasks")
+            .args(["/Run", "/TN", "NeuroVault-Eject"])
+            .creation_flags(CREATE_NO_WINDOW)
+            .status()
+            .map_err(|e| format!("Could not start the eject task: {e}"))?;
+        if !status.success() {
+            return Err(
+                "Eject task isn't registered — run Register-NeuroVault-Eject.ps1 once.".to_string(),
+            );
+        }
+    }
+
+    memory::watcher::stop_all();
+    memory::db::checkpoint_all();
+    memory::db::close_all();
+
+    Ok(format!("Flushed. Safely removing {drive} once NeuroVault closes."))
