@@ -0,0 +1,592 @@
+from __future__ import annotations
+
+import argparse
+import csv
+import fnmatch
+import hashlib
+import html
+import json
+import mimetypes
+import os
+import re
+import shutil
+import zipfile
+from datetime import datetime, timezone
+from pathlib import Path
+
+
+SKIP_DIRS = {
+    ".claude",
+    ".git",
+    ".hg",
+    ".svn",
+    ".next",
+    ".nuxt",
+    ".turbo",
+    ".vite",
+    ".venv",
+    "__pycache__",
+    "build",
+    "cache",
+    "coverage",
+    "cuda_outputs",
+    "dist",
+    "downloads",
+    "external-repos",
+    "node_modules",
+    "logs",
+    "live_backups",
+    "memory_backups",
+    "models",
+    "outputs",
+    "pip_cache",
+    "release",
+    "target",
+    "uploads",
+    "venv",
+    "venv_cuda",
+    "MegaGym-Website",
+}
+
+SKIP_SUFFIXES = (
+    ".neurovault.md",
+    ".neurovault.html",
+)
+
+SKIP_FILENAMES = {
+    ".env",
+    ".env.local",
+    ".env.development.local",
+    ".env.test.local",
+    ".env.production.local",
+    ".git",
+    ".skill-optimizer-ran",
+    ".cache",
+    ".metadata_cache.json",
+    "bun.lockb",
+    "libraries.json",
+    "package-lock.json",
+    "pnpm-lock.yaml",
+    "transcribepro-macos-buildkit.zip",
+    "transcribepro-windows-installer.zip",
+    "yarn.lock",
+    "youtube_cookies.txt",
+}
+
+SKIP_EXTS = {
+    ".mp4",
+    ".zip",
+}
+
+# Dirs whose files are BACKED UP (copied to _source_files on the SSD) but NOT indexed
+# into the brain — regenerable/binary output (screenshots, thumbnails, captures) that
+# would only bloat recall and blow up the knowledge graph. A project can add its own
+# backup-only paths via a `.neurovaultignore` file in its root (newline-separated
+# relative paths/globs, same copy-but-don't-index semantics) — e.g. a scraper's
+# `data/` output folder full of captured JSON.
+INDEX_EXCLUDE_DIRS = {
+    "screenshots", "screenshot", "screen_shots", "_screenshots",
+    "thumbs", "thumbnails", "thumbnail",
+    "captures",
+}
+NO_INDEX_FILE = ".neurovaultignore"
+
+TEXT_EXTS = {
+    "",
+    ".babelrc",
+    ".css",
+    ".csv",
+    ".cc",
+    ".cmake",
+    ".cpp",
+    ".dart",
+    ".entitlements",
+    ".env",
+    ".gradle",
+    ".gitignore",
+    ".h",
+    ".htm",
+    ".html",
+    ".iml",
+    ".ini",
+    ".java",
+    ".js",
+    ".json",
+    ".jsx",
+    ".kt",
+    ".kts",
+    ".lock",
+    ".log",
+    ".m",
+    ".manifest",
+    ".md",
+    ".mjs",
+    ".pbxproj",
+    ".plist",
+    ".properties",
+    ".ps1",
+    ".py",
+    ".rc",
+    ".sample",
+    ".scss",
+    ".sh",
+    ".storyboard",
+    ".swift",
+    ".svg",
+    ".toml",
+    ".ts",
+    ".tsx",
+    ".txt",
+    ".vue",
+    ".xcconfig",
+    ".xcsettings",
+    ".xcscheme",
+    ".xcworkspacedata",
+    ".xml",
+    ".yaml",
+    ".yml",
+}
+
+LANG_BY_EXT = {
+    ".css": "css",
+    ".csv": "csv",
+    ".cc": "cpp",
+    ".cmake": "cmake",
+    ".cpp": "cpp",
+    ".dart": "dart",
+    ".html": "html",
+    ".htm": "html",
+    ".java": "java",
+    ".js": "javascript",
+    ".jsx": "jsx",
+    ".kt": "kotlin",
+    ".kts": "kotlin",
+    ".m": "objective-c",
+    ".json": "json",
+    ".md": "markdown",
+    ".mjs": "javascript",
+    ".plist": "xml",
+    ".properties": "properties",
+    ".ps1": "powershell",
+    ".py": "python",
+    ".scss": "scss",
+    ".sh": "bash",
+    ".swift": "swift",
+    ".svg": "xml",
+    ".toml": "toml",
+    ".ts": "typescript",
+    ".tsx": "tsx",
+    ".vue": "vue",
+    ".xml": "xml",
+    ".yaml": "yaml",
+    ".yml": "yaml",
+}
+
+
+def slugify(value: str) -> str:
+    slug = re.sub(r"[^A-Za-z0-9]+", "-", value.strip()).strip("-").lower()
+    return slug or "project"
+
+
+def now_utc() -> str:
+    return datetime.now(timezone.utc).isoformat()
+
+
+def read_text_guess(path: Path) -> str:
+    data = path.read_bytes()
+    for enc in ("utf-8-sig", "utf-8", "utf-16", "cp1252", "latin-1"):
+        try:
+            return data.decode(enc)
+        except UnicodeDecodeError:
+            continue
+    return data.decode("utf-8", errors="replace")
+
+
+def normalize_newlines(text: str) -> str:
+    text = text.replace("\r\n", "\n").replace("\r", "\n")
+    return re.sub(r"\n{4,}", "\n\n\n", text).strip()
+
+
+def sha256_file(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def yaml_string(value: str) -> str:
+    return json.dumps(value, ensure_ascii=False)
+
+
+def frontmatter(source_rel: str, source_path: Path, digest: str, mode: str) -> str:
+    stat = source_path.stat()
+    return (
+        "---\n"
+        f"source_path: {yaml_string(source_rel)}\n"
+        f"source_sha256: {yaml_string(digest)}\n"
+        f"source_bytes: {stat.st_size}\n"
+        f"source_modified_utc: {yaml_string(datetime.fromtimestamp(stat.st_mtime, timezone.utc).isoformat())}\n"
+        f"conversion_mode: {yaml_string(mode)}\n"
+        "---\n\n"
+    )
+
+
+def code_markdown(source_rel: str, path: Path, digest: str, text: str) -> str:
+    lang = LANG_BY_EXT.get(path.suffix.lower(), "")
+    fence = "```"
+    while fence in text:
+        fence += "`"
+    return (
+        frontmatter(source_rel, path, digest, "text-code")
+        + f"# Source File: {source_rel}\n\n"
+        + "Original file is preserved beside this generated markdown sidecar.\n\n"
+        + f"Original SHA-256: `{digest}`\n\n"
+        + "## Content\n\n"
+        + f"{fence}{lang}\n{text.rstrip()}\n{fence}\n"
+    )
+
+
+def html_text_markdown(source_rel: str, path: Path, digest: str, text: str) -> str:
+    stripped = re.sub(r"(?is)<(script|style).*?</\1>", "\n", text)
+    stripped = re.sub(r"(?is)<br\s*/?>", "\n", stripped)
+    stripped = re.sub(r"(?is)</(p|div|h[1-6]|li|tr|table)>", "\n", stripped)
+    stripped = re.sub(r"(?is)<[^>]+>", " ", stripped)
+    stripped = normalize_newlines(html.unescape(re.sub(r"[ \t]+", " ", stripped)))
+    return (
+        frontmatter(source_rel, path, digest, "html-text")
+        + f"# HTML File: {source_rel}\n\n"
+        + "Original file is preserved beside this generated markdown sidecar.\n\n"
+        + f"Original SHA-256: `{digest}`\n\n"
+        + "## Extracted Text\n\n"
+        + (stripped or "[No visible text extracted.]")
+        + "\n\n## Raw HTML\n\n"
+        + "```html\n"
+        + text.rstrip()
+        + "\n```\n"
+    )
+
+
+def binary_markdown(source_rel: str, path: Path, digest: str) -> str:
+    mime, _ = mimetypes.guess_type(path.name)
+    return (
+        frontmatter(source_rel, path, digest, "binary-metadata")
+        + f"# Binary Asset: {source_rel}\n\n"
+        + "Original file is preserved beside this generated metadata note.\n\n"
+        + f"- SHA-256: `{digest}`\n"
+        + f"- Bytes: `{path.stat().st_size}`\n"
+        + f"- MIME guess: `{mime or 'unknown'}`\n"
+    )
+
+
+def write_markdown_for_file(source_rel: str, path: Path) -> tuple[Path, str, int, str]:
+    digest = sha256_file(path)
+    ext = path.suffix.lower()
+    if ext == ".md":
+        try:
+            chars = len(read_text_guess(path))
+        except Exception:
+            chars = 0
+        return path, "markdown-original", chars, digest
+    if ext in {".html", ".htm"}:
+        text = normalize_newlines(read_text_guess(path))
+        md_path = path.with_name(f"{path.name}.neurovault.md")
+        md_path.write_text(html_text_markdown(source_rel, path, digest, text), encoding="utf-8")
+        return md_path, "html-text", len(text), digest
+    if ext in TEXT_EXTS:
+        text = normalize_newlines(read_text_guess(path))
+        md_path = path.with_name(f"{path.name}.neurovault.md")
+        md_path.write_text(code_markdown(source_rel, path, digest, text), encoding="utf-8")
+        return md_path, "text-code", len(text), digest
+    md_path = path.with_name(f"{path.name}.neurovault.md")
+    md_path.write_text(binary_markdown(source_rel, path, digest), encoding="utf-8")
+    return md_path, "binary-metadata", 0, digest
+
+
+def should_skip_dir(path: Path, extra_skip_dirs: set[str] | None = None) -> bool:
+    extra_skip_dirs = extra_skip_dirs or set()
+    return path.name in SKIP_DIRS or path.name in extra_skip_dirs or path.name.startswith(".cache")
+
+
+def load_no_index_patterns(source: Path) -> list[str]:
+    """Read <source>/.neurovaultignore: newline-separated relative paths/globs of files
+    to BACK UP (copy to the SSD) but NOT index into the brain. Blank lines and #-comments
+    are ignored. Lets a project keep bulk data/outputs out of recall + the knowledge graph
+    while still preserving them on the SSD."""
+    f = source / NO_INDEX_FILE
+    pats: list[str] = []
+    if f.is_file():
+        for line in f.read_text(encoding="utf-8", errors="replace").splitlines():
+            s = line.strip()
+            if s and not s.startswith("#"):
+                pats.append(s.replace("\\", "/").rstrip("/"))
+    return pats
+
+
+def is_index_excluded(rel: str, no_index_patterns: list[str]) -> bool:
+    """True if this file should be copied-but-NOT-indexed: it lives under an
+    INDEX_EXCLUDE_DIRS folder, or matches a `.neurovaultignore` pattern (path prefix
+    or glob). The file is still backed up to _source_files; it just gets no sidecar,
+    so it never enters the brain's recall or graph."""
+    rel = rel.replace("\\", "/")
+    if any(part in INDEX_EXCLUDE_DIRS for part in rel.split("/")[:-1]):
+        return True
+    for pat in no_index_patterns:
+        if rel == pat or rel.startswith(pat + "/") or fnmatch.fnmatch(rel, pat):
+            return True
+    return False
+
+
+def safe_zip_member(name: str) -> bool:
+    parts = Path(name.replace("\\", "/")).parts
+    return bool(parts) and not any(part in {"", ".", ".."} for part in parts)
+
+
+def iter_source_files(
+    source: Path,
+    extra_skip_dirs: set[str] | None = None,
+    extra_skip_filenames: set[str] | None = None,
+    extra_skip_exts: set[str] | None = None,
+) -> list[Path]:
+    extra_skip_dirs = extra_skip_dirs or set()
+    extra_skip_filenames = extra_skip_filenames or set()
+    extra_skip_exts = extra_skip_exts or set()
+    out: list[Path] = []
+    for root, dirs, files in os.walk(source):
+        root_path = Path(root)
+        dirs[:] = [d for d in dirs if not should_skip_dir(root_path / d, extra_skip_dirs)]
+        for name in files:
+            if name.startswith("~$") or name.lower().endswith(SKIP_SUFFIXES):
+                continue
+            if Path(name).suffix.lower() in SKIP_EXTS | extra_skip_exts:
+                continue
+            if name.lower() in SKIP_FILENAMES | extra_skip_filenames:
+                continue
+            out.append(root_path / name)
+    return sorted(out, key=lambda p: p.relative_to(source).as_posix().lower())
+
+
+def ensure_registry(nv_home: Path, brain_id: str, name: str, description: str, make_active: bool) -> None:
+    registry_path = nv_home / "brains.json"
+    data = json.loads(registry_path.read_text(encoding="utf-8"))
+    brains = data.setdefault("brains", [])
+    existing = next((b for b in brains if b.get("id") == brain_id), None)
+    if existing is None:
+        brains.append(
+            {
+                "created_at": now_utc(),
+                "description": description,
+                "id": brain_id,
+                "name": name,
+            }
+        )
+    else:
+        existing["name"] = name
+        existing["description"] = description
+    if make_active:
+        data["active"] = brain_id
+    tmp = registry_path.with_suffix(".json.tmp")
+    tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+    tmp.replace(registry_path)
+
+
+def import_project(
+    source: Path,
+    nv_home: Path,
+    brain_id: str,
+    name: str,
+    make_active: bool,
+    extra_skip_dirs: set[str] | None = None,
+    extra_skip_filenames: set[str] | None = None,
+    extra_skip_exts: set[str] | None = None,
+) -> dict:
+    description = f"Project archive cloned from {source}"
+    ensure_registry(nv_home, brain_id, name, description, make_active)
+
+    vault = nv_home / "brains" / brain_id / "vault"
+    raw_root = vault / "_source_files" / source.name
+    report_root = vault / "_neurovault_index"
+    raw_root.mkdir(parents=True, exist_ok=True)
+    report_root.mkdir(parents=True, exist_ok=True)
+
+    no_index_patterns = load_no_index_patterns(source)
+    rows: list[dict[str, str | int]] = []
+    copied = 0
+    converted = 0
+    binary = 0
+    existing_md = 0
+    not_indexed = 0
+
+    for src in iter_source_files(source, extra_skip_dirs, extra_skip_filenames, extra_skip_exts):
+        rel = src.relative_to(source).as_posix()
+        dst = raw_root / rel
+        dst.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copy2(src, dst)
+        copied += 1
+
+        # Backup-only (copied to the SSD, but NOT indexed): keeps regenerable output and
+        # bulk data out of the brain's recall + graph. No sidecar is written for these.
+        if is_index_excluded(rel, no_index_patterns):
+            not_indexed += 1
+            rows.append({
+                "relative_path": rel, "extension": dst.suffix.lower(),
+                "bytes": dst.stat().st_size, "sha256": "",
+                "mode": "backup-only-no-index", "text_chars": 0, "markdown_path": "",
+            })
+            continue
+
+        md_path, mode, chars, digest = write_markdown_for_file(rel, dst)
+        ext = dst.suffix.lower()
+        if mode == "markdown-original":
+            existing_md += 1
+        elif mode in {"html-text", "text-code"}:
+            converted += 1
+        else:
+            binary += 1
+
+        rows.append(
+            {
+                "relative_path": rel,
+                "extension": ext,
+                "bytes": dst.stat().st_size,
+                "sha256": digest,
+                "mode": mode,
+                "text_chars": chars,
+                "markdown_path": md_path.relative_to(vault).as_posix(),
+            }
+        )
+
+        if ext == ".zip":
+            archive_slug = slugify(Path(rel).stem)
+            extract_root = raw_root / "_extracted_archives" / archive_slug
+            with zipfile.ZipFile(dst) as archive:
+                for member in archive.infolist():
+                    if member.is_dir() or not safe_zip_member(member.filename):
+                        continue
+                    member_rel = Path(member.filename.replace("\\", "/"))
+                    if any(part in SKIP_DIRS or part.startswith(".cache") for part in member_rel.parts):
+                        continue
+                    if member_rel.name.lower() in SKIP_FILENAMES:
+                        continue
+                    extracted = extract_root / member_rel
+                    extracted.parent.mkdir(parents=True, exist_ok=True)
+                    with archive.open(member) as src_handle, extracted.open("wb") as dst_handle:
+                        shutil.copyfileobj(src_handle, dst_handle)
+                    copied += 1
+                    extracted_rel = (
+                        Path("_source_files")
+                        / source.name
+                        / "_extracted_archives"
+                        / archive_slug
+                        / member_rel
+                    ).as_posix()
+                    archive_source_rel = f"{rel}!/{member.filename}"
+                    emd_path, emode, echars, edigest = write_markdown_for_file(
+                        archive_source_rel,
+                        extracted,
+                    )
+                    if emode == "markdown-original":
+                        existing_md += 1
+                    elif emode in {"html-text", "text-code"}:
+                        converted += 1
+                    else:
+                        binary += 1
+                    rows.append(
+                        {
+                            "relative_path": archive_source_rel,
+                            "extension": extracted.suffix.lower(),
+                            "bytes": extracted.stat().st_size,
+                            "sha256": edigest,
+                            "mode": f"zip-{emode}",
+                            "text_chars": echars,
+                            "markdown_path": emd_path.relative_to(vault).as_posix(),
+                        }
+                    )
+
+    csv_path = report_root / "project_import_report.csv"
+    with csv_path.open("w", encoding="utf-8", newline="") as handle:
+        writer = csv.DictWriter(handle, fieldnames=list(rows[0].keys()) if rows else [])
+        if rows:
+            writer.writeheader()
+            writer.writerows(rows)
+
+    md_report = report_root / "00_PROJECT_IMPORT_OVERVIEW.md"
+    with md_report.open("w", encoding="utf-8") as handle:
+        handle.write(f"# Project Import: {name}\n\n")
+        handle.write(f"Generated: {now_utc()}\n\n")
+        handle.write(f"Source: `{source}`\n\n")
+        handle.write(f"Brain ID: `{brain_id}`\n\n")
+        handle.write("## Summary\n\n")
+        handle.write(f"- Files copied: {copied}\n")
+        handle.write(f"- Existing markdown files preserved: {existing_md}\n")
+        handle.write(f"- Text/code/html files converted to markdown sidecars: {converted}\n")
+        handle.write(f"- Binary assets represented by metadata notes: {binary}\n")
+        handle.write(f"- Backed up but NOT indexed (screenshots/thumbs/.neurovaultignore): {not_indexed}\n\n")
+        handle.write("Original files are preserved under `_source_files/`; generated markdown sidecars are what NeuroVault indexes. Backup-only files are copied to the SSD but get no sidecar, so they never enter recall or the knowledge graph.\n\n")
+        handle.write("## Files\n\n")
+        handle.write("| Source | Mode | Bytes | Markdown |\n")
+        handle.write("|---|---|---:|---|\n")
+        for row in rows:
+            handle.write(
+                f"| `{row['relative_path']}` | `{row['mode']}` | {row['bytes']} | `{row['markdown_path']}` |\n"
+            )
+
+    return {
+        "brain_id": brain_id,
+        "brain_name": name,
+        "vault": str(vault),
+        "raw_root": str(raw_root),
+        "files_copied": copied,
+        "existing_markdown": existing_md,
+        "converted_sidecars": converted,
+        "binary_metadata_notes": binary,
+        "backup_only_not_indexed": not_indexed,
+        "report": str(md_report),
+        "csv": str(csv_path),
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description="Import a project folder into a NeuroVault brain.")
+    parser.add_argument("--source", required=True)
+    parser.add_argument("--nv-home", default=r"D:\NEURO-VAULT-STORAGE\.neurovault")
+    parser.add_argument("--brain-id")
+    parser.add_argument("--name")
+    parser.add_argument("--active", action="store_true")
+    parser.add_argument("--skip-dir", action="append", default=[], help="Additional directory basename to skip.")
+    parser.add_argument("--skip-file", action="append", default=[], help="Additional filename to skip.")
+    parser.add_argument("--skip-ext", action="append", default=[], help="Additional extension to skip, such as .png.")
+    args = parser.parse_args()
+
+    source = Path(args.source).resolve()
+    nv_home = Path(args.nv_home)
+    if not source.is_dir():
+        raise SystemExit(f"source folder not found: {source}")
+    if not (nv_home / "brains.json").is_file():
+        raise SystemExit(f"NeuroVault home not found: {nv_home}")
+
+    name = args.name or source.name
+    brain_id = args.brain_id or slugify(name)
+    extra_skip_dirs = set(args.skip_dir)
+    extra_skip_filenames = {name.lower() for name in args.skip_file}
+    extra_skip_exts = {
+        ext.lower() if ext.startswith(".") else f".{ext.lower()}"
+        for ext in args.skip_ext
+    }
+
+    result = import_project(
+        source,
+        nv_home,
+        brain_id,
+        name,
+        args.active,
+        extra_skip_dirs,
+        extra_skip_filenames,
+        extra_skip_exts,
+    )
+    print(json.dumps(result, ensure_ascii=False, indent=2))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
