+
+
+SOURCE_ROOT = Path(r"C:\Users\steli\Desktop\PwC\uni (thesis)")
+VAULT_ROOT = Path(r"D:\NEURO-VAULT-STORAGE\.neurovault\brains\thesis\vault")
+DEST_ROOT = VAULT_ROOT / "_source_files" / "uni (thesis)"
+REPORT_ROOT = VAULT_ROOT / "_neurovault_index"
+
+SKIP_DIRS = {".git", ".claude", "__pycache__"}
+SKIP_NAMES = {
+    ".mcp.json",
+    ".mcp.json.pre-v031-switch-20260531-1305.bak",
+}
+SKIP_SUFFIXES = (".neurovault.md", ".neurovault.html", ".mammoth.html")
+
+DOCX_NS = {"w": "http://schemas.openxmlformats.org/wordprocessingml/2006/main"}
+
+
+def sha256_file(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def iter_source_files() -> list[Path]:
+    files: list[Path] = []
+    for root, dirs, names in os.walk(SOURCE_ROOT):
+        dirs[:] = [d for d in dirs if d not in SKIP_DIRS]
+        root_path = Path(root)
+        for name in names:
+            if name.startswith("~$") or name in SKIP_NAMES or name.endswith(SKIP_SUFFIXES):
+                continue
+            files.append(root_path / name)
+    return sorted(files, key=lambda p: p.relative_to(SOURCE_ROOT).as_posix().lower())
+
+
+def needs_copy(src: Path, dst: Path) -> bool:
+    if not dst.exists():
+        return True
+    src_stat = src.stat()
+    dst_stat = dst.stat()
+    if src_stat.st_size == dst_stat.st_size and abs(src_stat.st_mtime - dst_stat.st_mtime) <= 2:
+        return False
+    return sha256_file(src) != sha256_file(dst)
+
+
+def docx_text(path: Path) -> str:
+    parts: list[str] = []
+    with zipfile.ZipFile(path) as archive:
+        for name in ("word/document.xml", "word/footnotes.xml", "word/endnotes.xml", "word/comments.xml"):
+            if name not in archive.namelist():
+                continue
+            root = ET.fromstring(archive.read(name))
+            if name != "word/document.xml":
+                parts.append(f"\n## {Path(name).stem.title()}\n")
+            for para in root.findall(".//w:p", DOCX_NS):
+                texts: list[str] = []
+                for node in para.iter():
+                    tag = node.tag.rsplit("}", 1)[-1]
+                    if tag == "t" and node.text:
+                        texts.append(node.text)
+                    elif tag == "tab":
+                        texts.append("\t")
+                    elif tag == "br":
+                        texts.append("\n")
+                line = "".join(texts).strip()
+                if line:
+                    parts.append(line)
+    text = "\n\n".join(parts)
+    return re.sub(r"\n{4,}", "\n\n\n", text).strip() or "[No text extracted from DOCX.]"
+
+
+def write_docx_sidecars(rel: str, dst: Path) -> tuple[Path, int, str]:
+    digest = sha256_file(dst)
+    stat = dst.stat()
+    text = docx_text(dst)
+    frontmatter = (
+        "---\n"
+        f"source_path: {json.dumps(rel, ensure_ascii=False)}\n"
+        f"source_sha256: {json.dumps(digest)}\n"
+        f"source_bytes: {stat.st_size}\n"
+        f"source_modified_utc: {json.dumps(datetime.fromtimestamp(stat.st_mtime, timezone.utc).isoformat())}\n"
+        'conversion_mode: "docx-xml-text"\n'
+        "---\n\n"
+    )
+    md = (
+        frontmatter
+        + f"# NeuroVault Conversion: {rel}\n\n"
+        + "This sidecar was generated during a thesis incremental refresh. "
+        + "Original file is preserved beside this generated markdown sidecar.\n\n"
+        + f"Original SHA-256: `{digest}`\n\n"
+        + "## Extracted Text\n\n"
+        + text
+        + "\n"
+    )
+    md_path = dst.with_name(f"{dst.name}.neurovault.md")
+    md_path.write_text(md, encoding="utf-8")
+
+    html_path = dst.with_name(f"{dst.name}.neurovault.html")
+    html_path.write_text(
+        "<!doctype html><meta charset=\"utf-8\">"
+        f"<title>{html.escape(rel)}</title>"
+        f"<h1>NeuroVault Conversion: {html.escape(rel)}</h1>"
+        f"<pre>{html.escape(text)}</pre>",
+        encoding="utf-8",
+    )
+    return md_path, len(text), digest
+
+
+def main() -> int:
+    if not SOURCE_ROOT.is_dir():
+        raise SystemExit(f"Missing source thesis folder: {SOURCE_ROOT}")
+    if not DEST_ROOT.is_dir():
+        raise SystemExit(f"Missing SSD thesis clone: {DEST_ROOT}")
+
+    REPORT_ROOT.mkdir(parents=True, exist_ok=True)
+    rows: list[dict[str, object]] = []
+
+    for src in iter_source_files():
+        rel = src.relative_to(SOURCE_ROOT).as_posix()
+        dst = DEST_ROOT / rel
+        if not needs_copy(src, dst):
+            continue
+        dst.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copy2(src, dst)
+        digest = sha256_file(dst)
+        mode = "binary-copied"
+        chars = 0
+        markdown_path = ""
+        if dst.suffix.lower() == ".docx":
+            md_path, chars, digest = write_docx_sidecars(rel, dst)
+            mode = "docx-xml-text"
+            markdown_path = md_path.relative_to(VAULT_ROOT).as_posix()
+        elif dst.suffix.lower() == ".md":
+            mode = "markdown-original"
+            markdown_path = dst.relative_to(VAULT_ROOT).as_posix()
+            chars = len(dst.read_text(encoding="utf-8", errors="replace"))
+
+        rows.append(
+            {
+                "relative_path": rel,
+                "mode": mode,
+                "bytes": dst.stat().st_size,
+                "sha256": digest,
+                "text_chars": chars,
+                "markdown_path": markdown_path,
+            }
+        )
+
+    report = REPORT_ROOT / f"thesis_incremental_update_{datetime.now().strftime('%Y-%m-%d_%H%M%S')}.md"
+    with report.open("w", encoding="utf-8") as handle:
+        handle.write("# Thesis Incremental Update\n\n")
+        handle.write(f"Generated: {datetime.now(timezone.utc).isoformat()}\n\n")
+        handle.write(f"Source: `{SOURCE_ROOT}`\n\n")
+        handle.write("Copied new/changed files into the SSD thesis vault and generated searchable sidecars for new DOCX files.\n\n")
+        handle.write("| Source | Mode | Bytes | Markdown |\n")
+        handle.write("|---|---|---:|---|\n")
+        for row in rows:
+            handle.write(
+                f"| `{row['relative_path']}` | `{row['mode']}` | {row['bytes']} | `{row['markdown_path']}` |\n"
+            )
+
+    print(json.dumps({"copied_or_changed": len(rows), "report": str(report), "rows": rows}, indent=2, ensure_ascii=False))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
