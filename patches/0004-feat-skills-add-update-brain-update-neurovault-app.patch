+"""
+scan.py -- discovery + staleness report for `/update-brain`.
+
+Read-only. Figures out, for the NeuroVault brain SSD:
+  1. Which existing brains map to which source project folder (read from each
+     brain's `_neurovault_index/00_PROJECT_IMPORT_OVERVIEW.md` "Source:" line).
+  2. How stale each mapped brain is vs its live source folder (new + changed
+     file counts), reusing the same skip rules + sha256 needs_copy logic as
+     thesis_incremental_refresh.py / _nv_staleness_check.py.
+  3. Under one or more PROJECT ROOT folders (where the user keeps all their
+     projects in File Explorer), which subfolders have NEVER been imported into
+     any brain at all.
+
+Nothing is copied or written. Output is a human report plus a machine-readable
+JSON block (after the LINE `===JSON===`) the skill can parse to decide what to
+refresh / create.
+
+Usage:
+  # Full sweep: all brains + scan these roots for never-imported projects
+  python scan.py --roots "C:\\Users\\steli\\Documents\\Claude_Projects"
+  # Multiple roots:
+  python scan.py --roots "C:\\...\\Claude_Projects" --roots "D:\\OtherProjects"
+  # Single project (is it imported? how stale?):
+  python scan.py --source "C:\\Users\\steli\\Documents\\Claude_Projects\\Makeup Game"
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+import re
+import sys
+from pathlib import Path
+
+NV_HOME_DEFAULT = r"D:\NEURO-VAULT-STORAGE\.neurovault"
+
+# Skip rules MIRRORED from scripts/import_project_vault.py so staleness counts
+# reflect what the importer would actually copy. Keep these in sync if the
+# importer's lists change.
+SKIP_DIRS = {
+    ".claude", ".git", ".hg", ".svn", ".next", ".nuxt", ".turbo", ".vite",
+    ".venv", "__pycache__", "build", "cache", "coverage", "cuda_outputs",
+    "dist", "downloads", "external-repos", "node_modules", "logs",
+    "live_backups", "memory_backups", "models", "outputs", "pip_cache",
+    "release", "target", "uploads", "venv", "venv_cuda", "MegaGym-Website",
+}
+SKIP_SUFFIXES = (".neurovault.md", ".neurovault.html", ".mammoth.html")
+SKIP_FILENAMES = {
+    ".env", ".env.local", ".env.development.local", ".env.test.local",
+    ".env.production.local", ".git", ".skill-optimizer-ran", ".cache",
+    ".metadata_cache.json", "bun.lockb", "libraries.json",
+    "package-lock.json", "pnpm-lock.yaml", "transcribepro-macos-buildkit.zip",
+    "transcribepro-windows-installer.zip", "yarn.lock", "youtube_cookies.txt",
+    # Config / not project content (the dedicated thesis importer skips these too,
+    # so staleness for the thesis brain doesn't show false positives).
+    ".mcp.json",
+}
+# .bak = local backups, never project content.
+SKIP_EXTS = {".mp4", ".zip", ".bak"}
+
+# Brains that are NOT project clones (skip in staleness / never flag as new).
+NON_PROJECT_BRAINS = {"master", "default"}
+
+# Brains handled by a dedicated importer (no standard import overview).
+SPECIAL_SOURCES = {
+    "thesis": r"C:\Users\steli\Desktop\PwC\uni (thesis)",
+}
+
+# When scanning a project root for NEVER-imported folders, ignore noise:
+# dotfolders, scratch folders (#...), and the NeuroVault app repo + its
+# legacy/backup/test clones (those are the app, not a project to index).
+def is_noise_folder(name: str) -> bool:
+    low = name.lower()
+    return (
+        name.startswith(".")
+        or name.startswith("#")
+        or low.startswith("neurovault")
+    )
+
+
+def sha256_file(p: Path) -> str:
+    h = hashlib.sha256()
+    with p.open("rb") as f:
+        for chunk in iter(lambda: f.read(1024 * 1024), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def iter_source_files(root: Path):
+    files = []
+    for d, dirs, names in os.walk(root):
+        dirs[:] = [x for x in dirs if x not in SKIP_DIRS]
+        for n in names:
+            if n.startswith("~$") or n.endswith(SKIP_SUFFIXES):
+                continue
+            if n in SKIP_FILENAMES:
+                continue
+            if Path(n).suffix.lower() in SKIP_EXTS:
+                continue
+            files.append(Path(d) / n)
+    return files
+
+
+def needs_copy(src: Path, dst: Path) -> bool:
+    if not dst.exists():
+        return True
+    s, d = src.stat(), dst.stat()
+    if s.st_size == d.st_size and abs(s.st_mtime - d.st_mtime) <= 2:
+        return False
+    return sha256_file(src) != sha256_file(dst)
+
+
+def norm(p: str | Path) -> str:
+    """Normalize a path for comparison: lowercase, no trailing slash."""
+    return os.path.normcase(os.path.normpath(str(p))).rstrip("\\/")
+
+
+def brain_source(nv_home: Path, brain_id: str) -> str | None:
+    """Recorded source folder for a brain, or None if undiscoverable."""
+    if brain_id in SPECIAL_SOURCES:
+        return SPECIAL_SOURCES[brain_id]
+    ov = nv_home / "brains" / brain_id / "vault" / "_neurovault_index" / "00_PROJECT_IMPORT_OVERVIEW.md"
+    if not ov.is_file():
+        return None
+    for line in ov.read_text(encoding="utf-8", errors="replace").splitlines():
+        m = re.match(r"^Source:\s*`?(.+?)`?\s*$", line)
+        if m:
+            return m.group(1)
+    return None
+
+
+def dest_for(nv_home: Path, brain_id: str, source: str) -> Path:
+    """Where the source is mirrored inside the brain vault."""
+    return nv_home / "brains" / brain_id / "vault" / "_source_files" / Path(source).name
+
+
+def staleness(source: str, dest: Path) -> dict:
+    src_root = Path(source)
+    if not src_root.is_dir():
+        return {"source_missing": True, "new": 0, "changed": 0, "total": 0}
+    new = changed = total = 0
+    for src in iter_source_files(src_root):
+        total += 1
+        dst = dest / src.relative_to(src_root)
+        if not dst.exists():
+            new += 1
+        elif needs_copy(src, dst):
+            changed += 1
+    return {"source_missing": False, "new": new, "changed": changed, "total": total}
+
+
+def load_brains(nv_home: Path) -> list[dict]:
+    reg = nv_home / "brains.json"
+    if not reg.is_file():
+        sys.exit(f"brains.json not found under {nv_home}")
+    data = json.loads(reg.read_text(encoding="utf-8"))
+    return data.get("brains", [])
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description="Discovery + staleness for /update-brain")
+    ap.add_argument("--nv-home", default=NV_HOME_DEFAULT)
+    ap.add_argument("--roots", action="append", default=[],
+                    help="Project-root folder to scan for never-imported projects (repeatable).")
+    ap.add_argument("--source", help="Single project folder: report its brain + staleness only.")
+    args = ap.parse_args()
+
+    nv_home = Path(args.nv_home)
+    brains = load_brains(nv_home)
+
+    # brain_id -> {name, source, dest}
+    mapped: dict[str, dict] = {}
+    source_index: dict[str, str] = {}  # norm(source) -> brain_id
+    for b in brains:
+        bid = b.get("id", "")
+        if bid in NON_PROJECT_BRAINS:
+            continue
+        src = brain_source(nv_home, bid)
+        if not src:
+            continue
+        mapped[bid] = {"name": b.get("name", bid), "source": src,
+                       "dest": str(dest_for(nv_home, bid, src))}
+        source_index[norm(src)] = bid
+
+    result: dict = {"mode": None, "brains": [], "unimported": [], "single": None}
+
+    # ---- Single-project mode -------------------------------------------------
+    if args.source:
+        result["mode"] = "single"
+        src = args.source
+        bid = source_index.get(norm(src))
+        print(f"# Single project: {src}\n")
+        if bid:
+            st = staleness(src, Path(mapped[bid]["dest"]))
+            print(f"Already imported as brain '{bid}' ({mapped[bid]['name']}).")
+            print(f"  new files:     {st['new']}")
+            print(f"  changed files: {st['changed']}")
+            print(f"  total scanned: {st['total']}")
+            verdict = "UP TO DATE" if st["new"] == 0 and st["changed"] == 0 else "STALE -> refresh recommended"
+            print(f"  verdict: {verdict}")
+            result["single"] = {"brain_id": bid, **mapped[bid], "staleness": st, "imported": True}
+        else:
+            print("NOT imported into any brain yet -> would create a NEW brain.")
+            result["single"] = {"brain_id": None, "source": src, "imported": False}
+        _emit_json(result)
+        return 0
+
+    # ---- Full sweep ----------------------------------------------------------
+    result["mode"] = "full"
+    print("# Brains mapped to a source folder\n")
+    for bid, info in sorted(mapped.items()):
+        st = staleness(info["source"], Path(info["dest"]))
+        flag = ("MISSING SRC" if st["source_missing"]
+                else "up to date" if st["new"] == 0 and st["changed"] == 0
+                else f"STALE (+{st['new']} new, ~{st['changed']} changed)")
+        print(f"  {bid:<40} {flag}")
+        result["brains"].append({"brain_id": bid, **info, "staleness": st})
+
+    # Never-imported projects under the given roots.
+    if args.roots:
+        print("\n# Never-imported project folders under scanned roots\n")
+        for root in args.roots:
+            rp = Path(root)
+            if not rp.is_dir():
+                print(f"  (root not found: {root})")
+                continue
+            for child in sorted(p for p in rp.iterdir() if p.is_dir()):
+                if norm(child) in source_index:
+                    continue
+                if is_noise_folder(child.name):
+                    continue
+                print(f"  NEW: {child}")
+                result["unimported"].append({"name": child.name, "source": str(child)})
+        if not result["unimported"]:
+            print("  (none -- every project folder already has a brain)")
+
+    _emit_json(result)
+    return 0
+
+
+def _emit_json(result: dict) -> None:
+    print("\n===JSON===")
+    print(json.dumps(result, ensure_ascii=False))
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
