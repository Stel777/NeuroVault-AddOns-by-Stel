     Ok(())
 }
 
+/// Safely flush + eject the external SSD that hosts the brain vault.
+///
+/// The SSD is the user's organized clone of source material that also
+/// lives on C:, so no off-drive copy is made — the eject just ensures
+/// the on-disk database is consistent, then releases the drive.
+///
+/// Steps, in order:
+///   1. Stop all vault watchers (release file handles, stop mid-writes).
+///   2. WAL-checkpoint every open brain so `brain.db` is fully written.
+///   3. Drop all cached DB handles (unmaps the mmap, closes the files).
+///   4. Spawn a DETACHED helper that waits for this app process to exit
+///      and then issues the Windows "safely remove" eject on the drive,
+///      retrying a few times. The caller (frontend) quits the app right
+///      after this returns, so the helper ejects once every handle is
+///      gone — the only reliable way given SQLite's 256 MiB mmap.
+///
+/// Returns a human-readable summary the UI can toast. Errors leave the
+/// drive un-ejected; the data is still flushed and safe on the SSD.
+#[tauri::command]
+fn nv_eject_ssd_brain() -> std::result::Result<String, String> {
+    let home = nv_home();
+    let home_str = home.to_string_lossy().to_string();
+    // Drive letter like "D:" from the brain-home path prefix.
+    let drive = if home_str.len() >= 2 && home_str.as_bytes()[1] == b':' {
+        home_str[..2].to_uppercase()
+    } else {
+        return Err("Could not determine the SSD drive letter from the brain home path.".to_string());
+    };
+    if drive == "C:" {
+        return Err("The active brain is on the system drive (C:), not a removable SSD — nothing to eject.".to_string());
+    }
+
+    // 1. Trigger the pre-registered "NeuroVault-Eject" scheduled task. A
+    //    task runs independently of this app's process tree, so it SURVIVES
+    //    the app closing — a spawned child gets killed the moment the app
+    //    exits, which is why an inline helper never finished. The task also
+    //    runs elevated, so the device-eject of the Fixed-type USB SSD isn't
+    //    blocked. Its script (Eject-NeuroVaultSSD.ps1) waits for this app to
+    //    exit, then safely removes the drive via CM_Request_Device_Eject
+    //    (which PRESERVES the drive letter for replug) and re-arms the
+    //    auto-open watcher. Trigger BEFORE touching the DB so a missing-task
+    //    failure aborts with no side effects. The task itself waits for our
+    //    exit, so starting it now is safe.
+    #[cfg(windows)]
+    {
+        use std::os::windows::process::CommandExt;
+        const CREATE_NO_WINDOW: u32 = 0x0800_0000;
+        let status = std::process::Command::new("schtasks")
+            .args(["/Run", "/TN", "NeuroVault-Eject"])
+            .creation_flags(CREATE_NO_WINDOW)
+            .status()
+            .map_err(|e| format!("Could not start the eject task: {e}"))?;
+        if !status.success() {
+            return Err(
+                "Eject task isn't registered — run Register-NeuroVault-Eject.ps1 once.".to_string(),
+            );
+        }
+    }
+
+    // 2. Stop watchers so nothing writes during the checkpoint.
+    memory::watcher::stop_all();
+    // 3. Flush every open brain's WAL into brain.db.
+    memory::db::checkpoint_all();
+    // 4. Release all DB handles (unmap mmap, close brain.db).
+    memory::db::close_all();
+
+    Ok(format!("Flushed. Safely removing {drive} once NeuroVault closes."))
+}
+
 // The Python-as-subprocess bridge (`run_python_job` + `python -m
 // neurovault_server <job>`) was removed 2026-05-16 when the Python
 // server package was deleted. The Rust backend now covers every
@@ -1637,6 +1706,8 @@ pub fn run() {
             // brain activation; the Tauri commands are here for
             // debug/manual control from Settings.
             nv_start_vault_watcher, nv_stop_vault_watcher,
+            // Safely flush + back up + eject the external SSD hosting the brain.
+            nv_eject_ssd_brain,
             // Drop-folder inbox: UI file-drop copies raw files into the
             // brain inbox for the connected agent to turn into notes.
             nv_inbox_add, nv_inbox_list,
