index 0000000..1607928
--- /dev/null
+++ b/.claude/skills/update-neurovault-app/stage-sidecar-dev.ps1
@@ -0,0 +1,66 @@
+<#
+  stage-sidecar-dev.ps1
+  ---------------------
+  Stage the `neurovault-server` MCP sidecar binary for a DEV build.
+
+  Why this is needed: since v0.5.x the app crate's build.rs (tauri_build)
+  validates that the externalBin `binaries/neurovault-server-<triple>[.exe]`
+  exists on EVERY compile of the crate -- including `cargo check` and
+  `tauri dev`. A fresh checkout has no such binary, so the build fails with:
+      resource path `binaries\neurovault-server-<triple>.exe` doesn't exist
+
+  The escape hatch (same trick as scripts/stage-sidecar.mjs, but debug):
+  build `neurovault-server` with TAURI_CONFIG overriding externalBin to []
+  so its own build.rs check is disabled, then copy the produced binary into
+  src-tauri/binaries/ where the app build expects it.
+
+  This is a build artifact -- src-tauri/binaries/ is gitignored. Re-run it
+  after a clean, after an upstream bump, or whenever cargo complains the
+  resource path doesn't exist.
+
+  Usage:  pwsh -File .claude/skills/update-neurovault/stage-sidecar-dev.ps1
+          (optional)  -Release   # stage from a release build instead of debug
+#>
+param([switch]$Release)
+
+$ErrorActionPreference = 'Stop'
+
+# Repo root = two levels up from this script (.claude/skills/update-neurovault/).
+$repo    = (Resolve-Path (Join-Path $PSScriptRoot '..\..\..')).Path
+$srcTauri = Join-Path $repo 'src-tauri'
+
+# Host target triple, e.g. x86_64-pc-windows-msvc.
+$hostLine = (& rustc -vV) | Where-Object { $_ -like 'host:*' }
+if (-not $hostLine) { throw 'could not determine host triple from `rustc -vV`' }
+$triple = $hostLine.Substring('host:'.Length).Trim()
+$exe = if ($triple -like '*windows*') { '.exe' } else { '' }
+$profile = if ($Release) { 'release' } else { 'debug' }
+
+Write-Host "[stage-sidecar-dev] building neurovault-server ($profile) for $triple (externalBin check disabled)"
+
+# Build the sidecar with externalBin removed from the effective config so its
+# build.rs does not require the very binary we are producing.
+$prevTauriConfig = $env:TAURI_CONFIG
+$env:TAURI_CONFIG = '{"bundle":{"externalBin":[]}}'
+try {
+    Push-Location $srcTauri
+    $cargoArgs = @('build', '--bin', 'neurovault-server')
+    if ($Release) { $cargoArgs += '--release' }
+    & cargo @cargoArgs
+    if ($LASTEXITCODE -ne 0) { throw "cargo build failed (exit $LASTEXITCODE)" }
+} finally {
+    Pop-Location
+    $env:TAURI_CONFIG = $prevTauriConfig
+}
+
+$built = Join-Path $srcTauri "target\$profile\neurovault-server$exe"
+if (-not (Test-Path $built)) { throw "built sidecar not found at $built" }
+
+$outDir = Join-Path $srcTauri 'binaries'
+New-Item -ItemType Directory -Force -Path $outDir | Out-Null
+$dest = Join-Path $outDir "neurovault-server-$triple$exe"
+Copy-Item $built $dest -Force
+
+$mb = '{0:N1}' -f ((Get-Item $dest).Length / 1MB)
+Write-Host "[stage-sidecar-dev] staged -> $dest ($mb MB)"
+Write-Host "[stage-sidecar-dev] done. You can now run: cd src-tauri; cargo check"
