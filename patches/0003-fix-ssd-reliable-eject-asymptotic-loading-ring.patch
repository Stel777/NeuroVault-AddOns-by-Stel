@@ -70,15 +71,19 @@ if ($disk) {
   }
 } else { L "no disk found for ${dl}:" }
 
-# 4. Re-arm the watcher for the next replug.
-Start-ScheduledTask -TaskName $Task -ErrorAction SilentlyContinue
-
-# 5. Feedback.
+# 4 + 5. Re-arm the watcher and report. On a FAILED eject the drive is
+# still present, so drop a sentinel FIRST: it tells the re-armed watcher
+# to treat the current presence as baseline instead of relaunching the
+# app (the app reopening is what re-locks the drive and defeats a retry).
+# A genuine unplug + replug still auto-opens.
 if ($ejected) {
+  Start-ScheduledTask -TaskName $Task -ErrorAction SilentlyContinue
   L "done: safely removed ${dl}:"
 } else {
-  L "could NOT eject ${dl}: (a handle is still open) - drive left mounted, data already flushed"
+  New-Item -ItemType File -Path $suppress -Force | Out-Null
+  Start-ScheduledTask -TaskName $Task -ErrorAction SilentlyContinue
