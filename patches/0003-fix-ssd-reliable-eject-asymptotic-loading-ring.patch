diff --git a/Show-NeuroVault-Splash.ps1 b/Show-NeuroVault-Splash.ps1
index 8fa84e8..87c3476 100644
--- a/Show-NeuroVault-Splash.ps1
+++ b/Show-NeuroVault-Splash.ps1
@@ -171,29 +171,58 @@ function Start-Fill([bool]$loop, [scriptblock]$onDone) {
     $fillRing.BeginAnimation([System.Windows.Shapes.Shape]::StrokeDashOffsetProperty, $a)
 }
 
+# ---- Fill state -----------------------------------------------------------
+# The fill is ASYMPTOTIC: it eases toward full but is capped below 100% and
+# only COMPLETES when the app window actually appears. So a full ring always
+# means "NeuroVault is up" - it never fills and then sits there waiting.
+$script:L     = [Math]::PI * 150.0 / 6.0   # ring circumference in dash units
+$script:p     = 0.0                         # current fill fraction 0..1
+$script:appUp = $false
+$fillTau      = 15.0   # creep time-constant in seconds (smaller = faster early)
+$fillCap      = 0.95   # never pass this until the app is genuinely up
+$previewUpAt  = 6.0    # in preview, pretend the app appears at 6s
+
 switch ($Style) {
     'spin' { Start-Spin }
+    'both' { Start-Fill $false { $fillRing.Visibility = 'Collapsed'; Start-Spin } }
     'fill' {
-        if ($Preview) { Start-Fill $true $null }
-        else          { Start-Fill $false { Start-Pulse } }
-    }
-    'both' {
-        Start-Fill $false {
-            $fillRing.Visibility = 'Collapsed'
-            Start-Spin
-        }
+        $fillRing.StrokeDashArray  = New-Object System.Windows.Media.DoubleCollection (,[double[]]@($script:L, $script:L))
+        $fillRing.StrokeDashOffset = $script:L   # start empty
+        $fillRing.Visibility       = 'Visible'
     }
 }
 
-# ---- Self-close logic -----------------------------------------------------
-$script:deadline = if ($Preview) { (Get-Date).AddSeconds(8) } else { (Get-Date).AddSeconds($TimeoutSeconds) }
+# ---- Drive the fill + self-close ------------------------------------------
+$script:start    = Get-Date
+$script:tick     = 0
+$script:deadline = if ($Preview) { (Get-Date).AddSeconds(12) } else { (Get-Date).AddSeconds($TimeoutSeconds) }
 $script:timer = New-Object System.Windows.Threading.DispatcherTimer
-$script:timer.Interval = [TimeSpan]::FromMilliseconds($PollMs)
+$script:timer.Interval = [TimeSpan]::FromMilliseconds(120)
 $script:timer.Add_Tick({
-    $up = if ($Preview) { $false } else { NeuroVault-WindowUp }
-    if ($up -or ((Get-Date) -gt $script:deadline)) {
-        $script:timer.Stop()
-        $script:window.Close()
+    $script:tick++
+    $elapsed = ((Get-Date) - $script:start).TotalSeconds
+
+    # Detect the real app window (throttled to ~once a second).
+    if (-not $script:appUp) {
+        if ($Preview) { if ($elapsed -ge $previewUpAt) { $script:appUp = $true } }
+        elseif ($script:tick % 8 -eq 0) { if (NeuroVault-WindowUp) { $script:appUp = $true } }
+    }
+
+    if ($Style -eq 'fill') {
+        if ($script:appUp) {
+            # App is up: drive the ring the rest of the way, then close.
+            $script:p = [Math]::Min(1.0, $script:p + 0.06)
+            $fillRing.StrokeDashOffset = $script:L * (1.0 - $script:p)
+            if ($script:p -ge 1.0) { $script:timer.Stop(); $script:window.Close() }
+        } else {
+            # Still starting: ease toward the cap, never reaching full.
+            $target = $fillCap * (1.0 - [Math]::Exp(-$elapsed / $fillTau))
+            if ($target -gt $script:p) { $script:p = $target }
+            $fillRing.StrokeDashOffset = $script:L * (1.0 - $script:p)
+            if ((Get-Date) -gt $script:deadline) { $script:timer.Stop(); $script:window.Close() }
+        }
+    } else {
+        if ($script:appUp -or ((Get-Date) -gt $script:deadline)) { $script:timer.Stop(); $script:window.Close() }
     }
 })
 $script:timer.Start()
diff --git a/Watch-NeuroVault-SSD.ps1 b/Watch-NeuroVault-SSD.ps1
index 0d73cd8..fbe6b8b 100644
--- a/Watch-NeuroVault-SSD.ps1
+++ b/Watch-NeuroVault-SSD.ps1
@@ -26,6 +26,7 @@ $MarkerRelative = 'NEURO-VAULT-STORAGE\.neurovault\brains.json'
 $Launcher       = 'C:\Users\steli\Documents\Claude_Projects\NeuroVault_byDath\Start-NeuroVault-SSD.cmd'
 $PollSeconds    = 4
 $LogFile        = Join-Path $env:LOCALAPPDATA 'NeuroVault\auto-open.log'
+$SuppressFlag   = Join-Path $env:LOCALAPPDATA 'NeuroVault\suppress-autoopen.flag'
 # ---------------------------------------------------------------------------
 
 New-Item -ItemType Directory -Force -Path (Split-Path $LogFile) | Out-Null
@@ -64,7 +65,18 @@ function Launch-NeuroVault([string]$drive) {
 
 Write-Log "watcher started (poll ${PollSeconds}s, marker '$MarkerRelative')"
 
+# Baseline. Normally a watcher that starts with the SSD already present
+# treats that as a connect and launches once (e.g. at logon). But if an
+# eject just re-armed us, a sentinel file tells us to treat the current
+# presence as the baseline instead - otherwise a failed eject would
+# immediately reopen the app and re-lock the drive. A genuine unplug +
+# replug (a real absent -> present transition) still launches.
 $prevPresent = $false
+if (Test-Path -LiteralPath $SuppressFlag) {
+    Remove-Item -LiteralPath $SuppressFlag -Force -ErrorAction SilentlyContinue
+    $prevPresent = [bool](Find-SsdDrive)
+    Write-Log "suppress flag honored - baseline set, not auto-launching the already-present SSD"
+}
 while ($true) {
     $drive   = Find-SsdDrive
     $present = [bool]$drive
diff --git a/src-tauri/src/memory/db.rs b/src-tauri/src/memory/db.rs
index c56af31..6236c80 100644
--- a/src-tauri/src/memory/db.rs
+++ b/src-tauri/src/memory/db.rs
@@ -117,6 +117,29 @@ pub fn close_all() {
     cache().write().clear();
 }
 
+/// Checkpoint (TRUNCATE) the WAL of every currently-open brain so all
+/// pending writes land in `brain.db` and the `-wal`/`-shm` files shrink.
+/// Best-effort — used before ejecting the drive that hosts the brains so
+/// the on-disk database is complete and consistent. Stop the vault
+/// watchers first so nothing is mid-write during the checkpoint.
+pub fn checkpoint_all() {
+    let map = cache().read();
+    for db in map.values() {
+        let conn = db.lock();
+        // Drop the 256 MiB memory-map FIRST (mmap_size=0 unmaps on the
+        // live connection). On Windows the mmap "section" keeps the SSD
+        // marked in-use and can linger until the process exits — which
+        // is why ejecting used to require quitting the app (after which
+        // the watcher relaunched it and re-locked the drive). Releasing
+        // the mapping here lets close_all() free every D: handle while
+        // the app is still running, so CM_Request_Device_Eject no longer
+        // gets vetoed. Then TRUNCATE-checkpoint so brain.db is complete.
+        let _ = conn.execute_batch(
+            "PRAGMA mmap_size=0; PRAGMA wal_checkpoint(TRUNCATE);",
+        );
+    }
+}
+
 /// Core open routine: create the brain dir, open the SQLite file, set
 /// pragmas, load sqlite-vec, run migrations, apply the schema script,
 /// create the vec0 virtual table if it's absent. Not cached — callers
